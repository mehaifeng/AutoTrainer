<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AutoTrainer.App"
             xmlns:local="using:AutoTrainer"
			 xmlns:converters="using:AutoTrainer.Converters"
			 xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
             xmlns:themes="clr-namespace:Avalonia.Themes.Fluent;assembly=Avalonia.Themes.Fluent"
             RequestedThemeVariant="Default">
             
    <!-- Application Resources -->
    <Application.Resources>
        <!-- Converters -->
        <converters:FileNameConverter x:Key="FileNameConverter"/>
        <converters:StringUpperCaseConverter x:Key="StringUpperCaseConverter"/>
        <converters:BoolToValidationSplitTipConverter x:Key="BoolToValidationSplitTipConverter"/>
        
        <!-- 自定义语义化颜色（使用 FluentTheme 资源避免硬编码） -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="{DynamicResource SystemAccentColor}"/>
        <SolidColorBrush x:Key="SuccessBrush">#4CAF50</SolidColorBrush>
        <SolidColorBrush x:Key="WarningBrush">#FF9800</SolidColorBrush>
        <SolidColorBrush x:Key="ErrorBrush">#F44336</SolidColorBrush>
        
        <!-- 常用边框颜色 -->
        <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource SystemBaseMediumLowColor}"/>
        
        <!-- 常用前景色（中灰色，用于辅助文本） -->
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="{DynamicResource SystemBaseMediumHighColor}"/>
    </Application.Resources>
    
    <!-- Application Styles -->
	<Application.Styles>
        <!-- Fluent Theme with custom accent color -->
        <themes:FluentTheme>
            <themes:FluentTheme.Palettes>
                <!-- Light Theme -->
                <themes:ColorPaletteResources 
					x:Key="Light" 
                    Accent="#2196F3"
                    RegionColor="#FAFAFA"
                    ErrorText="#F44336"/>
                
                <!-- Dark Theme -->
                <themes:ColorPaletteResources 
					x:Key="Dark" 
                    Accent="#42A5F5"
                    RegionColor="#121212"
                    ErrorText="#EF5350"/>
            </themes:FluentTheme.Palettes>
        </themes:FluentTheme>
        
        <!-- 通知组件样式 -->
		<StyleInclude Source="avares://Notification.Avalonia/Themes/Generic.xaml"/>

        <!-- 图标库样式 -->
		<StyleInclude Source="avares://IconPacks.Avalonia.Material/Material.axaml" />

        <!-- 颜色选择器样式 -->
		<StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
        
        <!-- 自定义实用样式类 -->
        
        <!-- 主要按钮样式（使用系统主题色） -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemAltHighColor}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColorLight1}"/>
        </Style>
        
        <!-- 成功按钮样式 -->
        <Style Selector="Button.success">
            <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="16,8"/>
        </Style>
        
        <!-- 警告按钮样式 -->
        <Style Selector="Button.warning">
            <Setter Property="Background" Value="{StaticResource WarningBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="16,8"/>
        </Style>
        
        <!-- 错误/危险按钮样式 -->
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="{StaticResource ErrorBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="16,8"/>
        </Style>
        
        <!-- 卡片样式（响应主题） -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource SystemChromeMediumLowColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemBaseMediumLowColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        
        <!-- 次要文本样式 -->
        <Style Selector="TextBlock.secondary">
            <Setter Property="Foreground" Value="{DynamicResource SystemBaseMediumHighColor}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        
        <!-- 标题样式 -->
        <Style Selector="TextBlock.title">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        
        <!-- 分隔线样式 -->
        <Style Selector="Separator.themed">
            <Setter Property="Background" Value="{DynamicResource SystemBaseMediumLowColor}"/>
            <Setter Property="Height" Value="1"/>
        </Style>
	</Application.Styles>

    <!-- Data Templates -->
    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
</Application>