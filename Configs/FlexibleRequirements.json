{
  "base": {
    "pip": [
      "setuptools>=65.0.0",
      "wheel>=0.40.0",
      "pip>=23.0.0"
    ]
  },
  "core": {
    "all": [
      "numpy>=1.24.0,<2.0.0",
      "scipy>=1.10.0",
      "pillow>=9.0.0",
      "matplotlib>=3.7.0",
      "scikit-learn>=1.3.0",
