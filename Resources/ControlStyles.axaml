<Styles xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Style Selector="Button.light">
		<Setter Property="Background" Value="#FFF5F5F5"/>
		<Setter Property="BorderBrush" Value="#FFE0E0E0"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="Foreground" Value="#FF333333"/>
	</Style>
	<Style Selector="Button.light:pointerover">
		<Setter Property="Background" Value="#FFE8E8E8"/>
		<Setter Property="BorderBrush" Value="#FFD0D0D0"/>
	</Style>
	<Style Selector="Button.flat">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="BorderBrush" Value="Transparent"/>
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="Foreground" Value="#FF007ACC"/>
	</Style>
	<Style Selector="Button.flat:pointerover">
		<Setter Property="Background" Value="#22007ACC"/>
	</Style>
	<Style Selector="Border.card">
		<Setter Property="Background" Value="White"/>
		<Setter Property="BorderBrush" Value="#FFE0E0E0"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="CornerRadius" Value="8"/>
		<Setter Property="BoxShadow" Value="0 2 4 0 #1A000000"/>
	</Style>
	<Style Selector="TextBlock.headline6">
		<Setter Property="FontSize" Value="20"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="Margin" Value="0,0,0,8"/>
	</Style>
	<Style Selector="TextBlock.body2">
		<Setter Property="FontSize" Value="14"/>
		<Setter Property="Opacity" Value="0.7"/>
		<Setter Property="Margin" Value="0,0,0,8"/>
	</Style>
	<Style Selector="TextBox.filled">
		<Setter Property="Background" Value="#FFF5F5F5"/>
		<Setter Property="BorderBrush" Value="Transparent"/>
		<Setter Property="Foreground" Value="#FF080808"/>
	</Style>
	<Style Selector="TextBox.filled:focus">
		<Setter Property="Background" Value="White"/>
		<Setter Property="BorderBrush" Value="#FF007ACC"/>
		<Setter Property="BorderThickness" Value="2"/>
	</Style>
	<Style Selector="ListBoxItem">
		<Setter Property="Foreground" Value="Transparent" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Padding" Value="8" />
		<Setter Property="Template">
			<ControlTemplate>
				<Border Name="PART_RootBorder"
						CornerRadius="{TemplateBinding CornerRadius}"
						Background="{TemplateBinding Background}"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}">
					<Panel Name="PART_RootPanel">
						<Border Name="selectedBorder"
								Background="{TemplateBinding Foreground}"
								CornerRadius="{TemplateBinding CornerRadius}" />
						<Border Name="pointerOverBorder"
								Background="{TemplateBinding Foreground}"
								CornerRadius="{TemplateBinding CornerRadius}" />
						<Border CornerRadius="{TemplateBinding CornerRadius}"
								ClipToBounds="True">
							<ContentPresenter Name="PART_ContentPresenter"
											  Background="{TemplateBinding Background}"
											  BorderBrush="{TemplateBinding BorderBrush}"
											  BorderThickness="{TemplateBinding BorderThickness}"
											  ContentTemplate="{TemplateBinding ContentTemplate}"
											  Content="{TemplateBinding Content}"
											  Padding="{TemplateBinding Padding}"
											  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
											  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" />
						</Border>
					</Panel>
				</Border>
			</ControlTemplate>
		</Setter>
	</Style>
</Styles>
