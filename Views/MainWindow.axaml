<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AutoTrainer.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		        xmlns:local="clr-namespace:AutoTrainer;assembly=AutoTrainer"
		        xmlns:userControls="clr-namespace:AutoTrainer.Views.UserControls"
			        mc:Ignorable="d" 
				d:DesignWidth="1300" 
				d:DesignHeight="850"
				Width="1300"
				Height="850"
				WindowStartupLocation="CenterScreen"
				Closed="Window_Closed"
		        x:Class="AutoTrainer.Views.MainWindow"
				x:DataType="vm:MainWindowViewModel"
		        Icon="/Assets/avalonia-logo.ico"
		        Title="AutoTrainer">
			<TabControl SelectedIndex="{Binding SelectTabIndex}" AutoScrollToSelectedItem="True" Theme="{StaticResource ScrollableTabControl}">
				<TabControl.Items>
					<TabItem Header="模型">
						<local:ModelConfigView />
					</TabItem>
					<TabItem Header="训练集">
						<local:DatasetAnnotationView/>
					</TabItem>
					<TabItem Header="参数配置">
						<local:ParameterConfigView/>
					</TabItem>
					<TabItem Header="训练">
						<local:TrainingView/>
					</TabItem>
					<TabItem Header="进阶验证">
						<userControls:ValidModelPerformanceView/>
					</TabItem>
					<TabItem Header="导出">
						<local:ConvertToExportView/>
					</TabItem>
				</TabControl.Items>
			</TabControl>
		</Window>
