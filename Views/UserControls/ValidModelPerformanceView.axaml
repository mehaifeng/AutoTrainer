<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
             xmlns:viewmodel="using:AutoTrainer.ViewModels"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             xmlns:app="clr-namespace:AutoTrainer"
             mc:Ignorable="d"
             d:DesignWidth="1200"
             d:DesignHeight="850"
             x:Class="AutoTrainer.Views.UserControls.ValidModelPerformanceView"
             x:DataType="{x:Type viewmodel:ValidModelPerformanceViewModel}"
             DataContext="{x:Static app:App.ValidationVM}">
	<Interaction.Behaviors>
		<EventTriggerBehavior EventName="Loaded">
			<InvokeCommandAction Command="{Binding LoadedCommand}"/>
		</EventTriggerBehavior>
	</Interaction.Behaviors>
    <Grid ColumnDefinitions=".3*,.7*">
        <!--任务类型，模型选择，开始验证-->
        <Grid Margin="10" RowDefinitions="Auto,*">
            <Expander Header="任务配置" IsExpanded="True" Margin="0,0,0,10" HorizontalAlignment="Stretch">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,60">
                    <!--任务类型-->
                    <StackPanel Grid.Row="0" Orientation="Vertical">
                        <Label Content="任务类型"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton
                                Content="目标分类"
                                IsChecked="{Binding IsCheckedClassifyMode}"
                                Margin="0,0,20,0"/>
                            <RadioButton
                                Content="目标检测"
                                IsChecked="{Binding !IsCheckedClassifyMode}"/>
                        </StackPanel>
                    </StackPanel>
                    <!--模型权重-->
                    <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,10,0,0">
                        <Label Content="当前模型权重"/>
                        <Grid ColumnDefinitions="*,45">
                            <TextBox Text="{Binding ModelWeightsPath}"/>
                            <Button Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Stretch"
                                    Command="{Binding SelectWeightsFileCommand}">
                                <iconPacks:PackIconMaterial Kind="DotsHorizontal" Width="16" Height="16" VerticalAlignment="Center"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                    <!--验证目录-->
                    <StackPanel Grid.Row="2" Orientation="Vertical" Margin="0,10,0,0">
                        <Label Content="验证集目录"/>
                        <Grid ColumnDefinitions="*,45">
                            <TextBox Text="{Binding ValidDatasetPath}"/>
                            <Button
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                VerticalAlignment="Stretch"
                                Command="{Binding SelectValidDatasetPathCommand}">
                                <iconPacks:PackIconMaterial Kind="DotsHorizontal" Width="16" Height="16" VerticalAlignment="Center"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                    <!--COCO标注文件-->
                    <StackPanel Grid.Row="3" Orientation="Vertical" Margin="0,10,0,0" IsVisible="{Binding !IsCheckedClassifyMode}">
                        <Label Content="COCO标注文件"/>
                        <Grid ColumnDefinitions="*,45">
                            <TextBox Text="{Binding CocoAnnotationPath}"/>
                            <Button Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Stretch"
                                    Command="{Binding SelectCocoFileCommand}">
                                <iconPacks:PackIconMaterial Kind="DotsHorizontal" Width="16" Height="16" VerticalAlignment="Center"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                    <!--置信度阈值（仅目标检测）-->
                    <StackPanel Grid.Row="4" Orientation="Vertical" Margin="0,10,0,0" IsVisible="{Binding !IsCheckedClassifyMode}">
                        <Label Content="置信度阈值"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <Slider 
                                Value="{Binding ConfidenceThreshold}" 
                                Minimum="0.1" 
                                Maximum="0.95" 
                                TickFrequency="0.05"
                                IsSnapToTickEnabled="True"
                                VerticalAlignment="Center"/>
                            <TextBlock 
                                Grid.Column="1"
                                Text="{Binding ConfidenceThreshold, StringFormat={}{0:F2}}"
                                Margin="10,0,0,0"
                                MinWidth="35"
                                VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                    <!--验证开始-->
                    <Button Grid.Row="5" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                            Command="{Binding StartVerificationCommand}"
                            IsEnabled="{Binding !IsVerifying}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="开始验证"/>
                            <iconPacks:PackIconMaterial Kind="Play" Margin="10,0,0,0" Width="16" Height="16" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Expander>
            <Expander Grid.Row="1" Header="验证集预览" IsExpanded="True" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding ValidDatasetImagePreviews}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Margin="5"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewmodel:ValidationPreviewImage">
                                <Border 
                                    Width="120" 
                                    Height="120" 
                                    Margin="5"
                                    Background="White"
                                    CornerRadius="5"
                                    BorderBrush="LightGray" 
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    Tapped="OnValidationPreviewImageTapped">
                                    <Border.Tag>
                                        <Binding Path="ImagePath"/>
                                    </Border.Tag>
                                    <Image
                                        Source="{Binding Thumbnail}"
                                        Stretch="Uniform"
                                        ToolTip.Tip="点击查看大图"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Expander>
        </Grid>
        <!--结果呈现-->
        <Grid 
			Grid.Column="1"
			RowDefinitions="*,5,350"
			Margin="10">
            <ProgressBar 
				IsIndeterminate="{Binding IsVerifying}"
				Width="100" 
				Height="5" 
				ZIndex="1"
                HorizontalAlignment="Center"
				VerticalAlignment="Top"
				Margin="0,10,0,0"/>
            <!--模型性能指标-->
            <Grid 
				Grid.Row="0" 
				RowDefinitions="20,*"
				VerticalAlignment="Stretch">
                <TextBlock Text="模型性能指标" FontSize="18" FontWeight="Bold"/>
                <Border Grid.Row="1" Margin="0,10,0,0" BorderBrush="Black" BorderThickness="1" CornerRadius="5">
                    <Grid>
                        <!--分类模型性能指标-->
                        <Grid RowDefinitions="80,*" Margin="10" IsVisible="{Binding IsCheckedClassifyMode}">
                            <UniformGrid Rows="1" Columns="4">
                                <Border Width="150" CornerRadius="5" BorderBrush="LightGray" BorderThickness="1">
                                    <StackPanel Orientation="Vertical"  VerticalAlignment="Center">
                                        <TextBlock Text="Accuracy" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding ClassificationMetrics.Accuracy}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Width="150" CornerRadius="5" BorderBrush="LightGray" BorderThickness="1">
                                    <StackPanel Orientation="Vertical"  VerticalAlignment="Center">
                                        <TextBlock Text="Recall" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding ClassificationMetrics.Recall}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Width="150" CornerRadius="5" BorderBrush="LightGray" BorderThickness="1">
                                    <StackPanel Orientation="Vertical"  VerticalAlignment="Center">
                                        <TextBlock Text="F1 Score" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding ClassificationMetrics.F1Score}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Width="150" CornerRadius="5" BorderBrush="LightGray" BorderThickness="1">
                                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                        <TextBlock Text="Time" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding ClassificationMetrics.Time}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                            <lvc:CartesianChart
								Grid.Row="1" 
								Series="{Binding ChartSeries}" 
								XAxes="{Binding ChartXAxes}"
								YAxes="{Binding ChartYAxes}"
								Margin="10"/>
                        </Grid>
                        <!--目标检测模型性能指标-->
                        <Grid RowDefinitions="80,*" Margin="10" IsVisible="{Binding !IsCheckedClassifyMode}">
                            <UniformGrid Rows="1" Columns="5">
                                <Border Width="120" CornerRadius="5" BorderBrush="LightGray" BorderThickness="1">
                                    <StackPanel Orientation="Vertical"  VerticalAlignment="Center">
                                        <TextBlock Text="mAP@.5" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding DetectionMetrics.Map50}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Width="120" CornerRadius="5" BorderBrush="LightGray" BorderThickness="1">
                                    <StackPanel Orientation="Vertical"  VerticalAlignment="Center">
                                        <TextBlock Text="mAP@.5:.95" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding DetectionMetrics.Map50_95}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Width="120" CornerRadius="5" BorderBrush="LightGray" BorderThickness="1">
                                    <StackPanel Orientation="Vertical"  VerticalAlignment="Center">
                                        <TextBlock Text="Precision" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding DetectionMetrics.Precision}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Width="120" CornerRadius="5" BorderBrush="LightGray" BorderThickness="1">
                                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                        <TextBlock Text="Recall" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding DetectionMetrics.Recall}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Width="120" CornerRadius="5" BorderBrush="LightGray" BorderThickness="1">
                                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                        <TextBlock Text="Time" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding DetectionMetrics.Time}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                            <lvc:CartesianChart 
								Grid.Row="1" 
								Series="{Binding ChartSeries}"
								XAxes="{Binding ChartXAxes}"
								YAxes="{Binding ChartYAxes}"
								VerticalAlignment="Stretch"
								Margin="10"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
			<GridSplitter
                Grid.Row="1"
				Margin="0,2,0,2"
				CornerRadius="5"
                HorizontalAlignment="Stretch"
				VerticalAlignment="Center"
                ResizeDirection="Rows"
                Cursor="SizeNorthSouth"/>
            <TabControl 
				Grid.Row="2"
				VerticalAlignment="Stretch"
				SelectedIndex="{Binding ResultTabIndex}"
				BorderBrush="Black" 
				BorderThickness="1"
				CornerRadius="5" >
                <TabItem Header="推理结果">
                    <Grid>
                        <!-- 分类模型结果 -->
                        <ScrollViewer IsVisible="{Binding IsCheckedClassifyMode}">
                            <ItemsControl ItemsSource="{Binding ClassifiedResults}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical" Spacing="10" Margin="10"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodel:ClassifiedImageGroup">
                                        <StackPanel>
                                            <TextBlock Text="{Binding ClassName}" FontSize="16" FontWeight="Bold"/>
                                            <ItemsControl ItemsSource="{Binding Images}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="viewmodel:ClassifiedImageItem">
                                                        <Border CornerRadius="5" BorderBrush="LightGray" BorderThickness="1" Margin="3" Width="100" Height="130">
                                                            <StackPanel>
                                                                <Image Source="{Binding Image}" Stretch="UniformToFill" Height="100"/>
                                                                <TextBlock 
                                                                    Text="{Binding ConfidenceText}" 
                                                                    FontSize="11"
                                                                    HorizontalAlignment="Center"
                                                                    Margin="0,2,0,0"
                                                                    Foreground="#666"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <!-- 目标检测结果 -->
                        <ScrollViewer IsVisible="{Binding !IsCheckedClassifyMode}">
                            <ItemsControl ItemsSource="{Binding DetectionResults}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Margin="10"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodel:DetectedImageResult">
                                        <Border BorderBrush="LightGray" BorderThickness="1" Margin="5" CornerRadius="5">
                                            <StackPanel>
                                                <!-- 图片区域（已包含标注框） -->
                                                <Border Width="250" Height="250" Background="White" Cursor="Hand"
                                                        Tapped="OnImageTapped">
                                                    <Border.Tag>
                                                        <Binding Path="SourceImage"/>
                                                    </Border.Tag>
                                                    <Image Source="{Binding SourceImage}" 
                                                           Stretch="Uniform" 
                                                           Width="250" 
                                                           Height="250"/>
                                                </Border>
                                                <!-- 信息区域 -->
                                                <StackPanel Orientation="Horizontal" Margin="5" HorizontalAlignment="Center">
                                                    <TextBlock 
                                                        Text="定位图片"
                                                        Foreground="Blue"
                                                        TextDecorations="Underline"
                                                        Cursor="Hand"
                                                        Tapped="OnPathTapped">
                                                        <TextBlock.Tag>
                                                            <Binding Path="ImagePath"/>
                                                        </TextBlock.Tag>
                                                    </TextBlock>
                                                    <TextBlock Text=" | 目标数:" Margin="5,0,3,0"/>
                                                    <TextBlock Text="{Binding ObjectCount}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
                <TabItem Header="推理输出">
                    <ScrollViewer>
                        <TextBox
							BorderThickness="0"
							Text="{Binding VerificationOutput}"
							IsReadOnly="True"
							TextWrapping="Wrap"
							Margin="10"/>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>
