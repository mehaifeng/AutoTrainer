<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AutoTrainer.ViewModels"
			 xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
			 xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
			 xmlns:ia="clr-namespace:Avalonia.Xaml.Interactions.Core;assembly=Avalonia.Xaml.Interactions"
			 xmlns:model="using:AutoTrainer.Models"
			 xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             xmlns:app="clr-namespace:AutoTrainer"
             mc:Ignorable="d"
             FontFamily=""
			 d:DesignWidth="1200"
			 d:DesignHeight="850"
			 Padding="20"
			 x:Name="TrainTabItem"
			 x:DataType="vm:TrainingViewModel"
             x:Class="AutoTrainer.TrainingView"
             DataContext="{x:Static app:App.TrainingVM}">
	<Interaction.Behaviors>
		<EventTriggerBehavior EventName="Loaded">
			<InvokeCommandAction Command="{Binding LoadParamInfoCommand}"/>
		</EventTriggerBehavior>
	</Interaction.Behaviors>
	
	<Grid ColumnDefinitions="360,*">
		<!-- 左侧面板 -->
		<Grid Grid.Column="0" RowDefinitions="Auto,*,Auto" Margin="0,0,10,0">
			
			<!-- 训练参数配置预览 -->
			<Border Grid.Row="0" 
			        BorderBrush="#E0E0E0" 
			        BorderThickness="1" 
			        CornerRadius="8"
			        Padding="15">
				<Grid RowDefinitions="Auto,*">
					<Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,12">
						<iconPacks:PackIconMaterial 
							Kind="FileDocumentOutline" 
							Width="16" 
							Height="16"
							VerticalAlignment="Center"/>
						<TextBlock 
							Grid.Column="1"
							Text="训练配置" 
							FontWeight="SemiBold" 
							FontSize="14"
							Margin="10,0,0,0"
							VerticalAlignment="Center"/>
					</Grid>
					<TextBox 
						Grid.Row="1" 
						MaxHeight="220"
						BorderThickness="0"
						Background="Transparent"
						IsReadOnly="True"
						TextWrapping="Wrap"
						FontSize="11"
						FontFamily="Consolas"
						Text="{Binding ModelParamStr}"/>
				</Grid>
			</Border>
			
			<!-- 训练输出日志 -->
			<Border Grid.Row="1" 
			        BorderBrush="#E0E0E0" 
			        BorderThickness="1" 
			        CornerRadius="8"
			        Padding="15"
			        Margin="0,10,0,0">
				<Grid RowDefinitions="Auto,*">
					<Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
						<iconPacks:PackIconMaterial 
							Kind="ConsoleNetwork" 
							Width="16" 
							Height="16"
							VerticalAlignment="Center"/>
						<TextBlock 
							Grid.Column="1"
							Text="训练日志" 
							FontWeight="SemiBold" 
							FontSize="14"
							Margin="10,0,0,0"
							VerticalAlignment="Center"/>
						<Button Grid.Column="2"
						        Padding="6,4"
						        Background="Transparent"
						        BorderThickness="0"
						        ToolTip.Tip="清空日志"
						        Command="{Binding ClearOutputCommand}">
							<iconPacks:PackIconMaterial 
								Kind="DeleteOutline" 
								Width="16" 
								Height="16"
								Foreground="#757575"/>
						</Button>
					</Grid>
					<TextBox
						Grid.Row="1"
						x:Name="PyOutput_Tb"
						BorderThickness="0"
						FontFamily="Consolas"
						FontSize="11"
						Padding="8"
						TextWrapping="Wrap"
						TextChanged="PyOutput_Tb_TextChanged"
						AcceptsReturn="True"
						IsReadOnly="True"
						Text="{Binding PyOutput}"/>
				</Grid>
			</Border>
			
			<!-- 系统性能监控 -->
			<Border Grid.Row="2" 
			        BorderBrush="#E0E0E0" 
			        BorderThickness="1" 
			        CornerRadius="8"
			        Padding="15"
			        Margin="0,10,0,0">
				<Grid RowDefinitions="Auto,Auto">
					<Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,12">
						<iconPacks:PackIconMaterial 
							Kind="ChartLine" 
							Width="16" 
							Height="16"
							VerticalAlignment="Center"/>
						<TextBlock 
							Grid.Column="1"
							Text="系统监控" 
							FontWeight="SemiBold" 
							FontSize="14"
							Margin="10,0,0,0"
							VerticalAlignment="Center"/>
					</Grid>
					
					<Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto">
						<!-- CPU -->
						<Border Grid.Row="0" 
						        CornerRadius="4" 
						        Padding="10,8"
						        Margin="0,0,0,8">
							<Grid ColumnDefinitions="Auto,*,Auto">
								<iconPacks:PackIconMaterial 
									Kind="Cpu64Bit" 
									Width="18" 
									Height="18"
									VerticalAlignment="Center"/>
								<TextBlock 
									Grid.Column="1"
									Text="CPU" 
									FontSize="12"
									Margin="8,0,0,0"
									VerticalAlignment="Center"/>
								<TextBlock 
									Grid.Column="2"
									Text="{Binding CPURate}" 
									FontWeight="SemiBold"
									FontSize="13"
									VerticalAlignment="Center"/>
							</Grid>
						</Border>
						
						<!-- GPU -->
						<Border Grid.Row="1" 
						        CornerRadius="4" 
						        Padding="10,8"
						        Margin="0,0,0,8">
							<Grid ColumnDefinitions="Auto,*,Auto">
								<iconPacks:PackIconMaterial 
									Kind="CardBulletedOutline" 
									Width="18" 
									Height="18"
									VerticalAlignment="Center"/>
								<TextBlock 
									Grid.Column="1"
									Text="GPU" 
									FontSize="12"
									Margin="8,0,0,0"
									VerticalAlignment="Center"/>
								<TextBlock 
									Grid.Column="2"
									Text="{Binding GPURate}" 
									FontWeight="SemiBold"
									FontSize="13"
									VerticalAlignment="Center"/>
							</Grid>
						</Border>
						
						<!-- RAM -->
						<Border Grid.Row="2" 
						        CornerRadius="4" 
						        Padding="10,8">
							<Grid ColumnDefinitions="Auto,*,Auto">
								<iconPacks:PackIconMaterial 
									Kind="Memory" 
									Width="18" 
									Height="18"
									VerticalAlignment="Center"/>
								<TextBlock 
									Grid.Column="1"
									Text="内存" 
									FontSize="12"
									Margin="8,0,0,0"
									VerticalAlignment="Center"/>
								<TextBlock 
									Grid.Column="2"
									Text="{Binding RAMRate}" 
									FontWeight="SemiBold"
									FontSize="13"
									VerticalAlignment="Center"/>
							</Grid>
						</Border>
					</Grid>
				</Grid>
			</Border>
		</Grid>
		
		<!-- 右侧图表和控制区 -->
		<Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto">
			
			<!-- 顶部操作栏 -->
			<Button Grid.Column="1"
				Padding="12,8"
				Margin="0,0,0,10"
				CornerRadius="4"
				BorderThickness="0"
				IsVisible="{Binding IsShowNextPage}"
				HorizontalAlignment="Right"
				Command="{Binding GotoNextPageCommand}"
				CommandParameter="{Binding ElementName=TrainTabItem}">
				<StackPanel Orientation="Horizontal">
					<TextBlock
						FontSize="14"
						VerticalAlignment="Center"
						Text="下一步"/>
					<iconPacks:PackIconMaterial
						Width="15"
						Height="15"
						Margin="8,0,0,0"
						VerticalAlignment="Center"
						Kind="ChevronRight" />
				</StackPanel>
			</Button>
			<!-- 训练进度卡片 -->
			<Border Grid.Row="1" 
			        BorderBrush="#E0E0E0" 
			        BorderThickness="1" 
			        CornerRadius="8"
			        Padding="20">
				<Grid RowDefinitions="Auto,Auto,Auto">
					<Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
						<TextBlock
							Text="训练进度"
							FontWeight="Medium"
							FontSize="13"/>
						<TextBlock
							Grid.Column="1"
							FontWeight="SemiBold"
							FontSize="14">
							<TextBlock.Text>
								<MultiBinding StringFormat="{}{0} / {1} 轮">
									<Binding Path="EpochState.CurrentEpoch" />
									<Binding Path="EpochState.TotalEpochs" />
								</MultiBinding>
							</TextBlock.Text>
						</TextBlock>
					</Grid>
					
					<ProgressBar
						Grid.Row="1"
						Height="8"
						Minimum="0"
						CornerRadius="4"
						BorderThickness="0"
						Maximum="{Binding EpochState.TotalEpochs}"
						Value="{Binding EpochState.CurrentEpoch}" />
					
					<Grid Grid.Row="2" ColumnDefinitions="*,*,*" Margin="0,12,0,0">
						<StackPanel Grid.Column="0" Spacing="4">
							<TextBlock Text="已完成" FontSize="11"/>
							<TextBlock Text="{Binding EpochState.CurrentEpoch}" 
							          FontSize="18" 
							          FontWeight="SemiBold"/>
						</StackPanel>
						<StackPanel Grid.Column="1" Spacing="4">
							<TextBlock Text="总轮数" FontSize="11"/>
							<TextBlock Text="{Binding EpochState.TotalEpochs}" 
							          FontSize="18" 
							          FontWeight="SemiBold"/>
						</StackPanel>
						<StackPanel Grid.Column="2" Spacing="4">
							<TextBlock Text="完成度" FontSize="11"/>
							<TextBlock FontSize="18" FontWeight="SemiBold">
								<TextBlock.Text>
									<MultiBinding StringFormat="{}{0:F1}%">
										<Binding Path="EpochState.ProgressPercentage" />
									</MultiBinding>
								</TextBlock.Text>
							</TextBlock>
						</StackPanel>
					</Grid>
				</Grid>
			</Border>
			
			<!-- 训练图表 -->
			<Border Grid.Row="2" 
			        BorderBrush="#E0E0E0" 
			        BorderThickness="1" 
			        CornerRadius="8"
			        Padding="20"
			        Margin="0,10,0,0">
				<Grid RowDefinitions="Auto,*">
					<TextBlock 
						Grid.Row="0"
						Text="损失与准确率曲线" 
						FontWeight="Medium" 
						FontSize="13"
						Margin="0,0,0,15"/>
					<lvc:CartesianChart 
						Grid.Row="1"
						Series="{Binding Series}" 
						XAxes="{Binding XAxes}" 
						YAxes="{Binding YAxes}">
					</lvc:CartesianChart>
				</Grid>
			</Border>
			
			<!-- 底部控制按钮 -->
			<Border Grid.Row="3" 
			        BorderThickness="0,1,0,0"
					Margin="0,10,0,0">
				<StackPanel 
					HorizontalAlignment="Center"
					Orientation="Horizontal"
					Spacing="15">
					<Button 
						Height="42"
						CornerRadius="6"
						BorderThickness="0"
						Command="{Binding StartTrainingCommand}"
						IsEnabled="{Binding !IsTraining}">
						<StackPanel Orientation="Horizontal" Spacing="8">
							<iconPacks:PackIconMaterial 
								Kind="Play" 
								Width="15" 
								Height="15"
								VerticalAlignment="Center"/>
							<TextBlock Text="开始训练" VerticalAlignment="Center"/>
						</StackPanel>
					</Button>
					<Button
						Height="42"
						CornerRadius="6"
						BorderThickness="0"
						Command="{Binding StopTrainingCommand}"
						IsEnabled="{Binding CanStopTraining}">
						<StackPanel Orientation="Horizontal" Spacing="8">
							<iconPacks:PackIconMaterial 
								Kind="Stop" 
								Width="15" 
								Height="15"
								VerticalAlignment="Center"/>
							<TextBlock Text="停止训练" VerticalAlignment="Center"/>
						</StackPanel>
					</Button>
				</StackPanel>
			</Border>
		</Grid>
	</Grid>
</UserControl>
