<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AutoTrainer.ViewModels"
			 xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
			 xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
			 xmlns:ia="clr-namespace:Avalonia.Xaml.Interactions.Core;assembly=Avalonia.Xaml.Interactions"
			 xmlns:model="using:AutoTrainer.Models"
			 xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             xmlns:app="clr-namespace:AutoTrainer"
             mc:Ignorable="d"
             FontFamily=""
			 d:DesignWidth="1200"
			 d:DesignHeight="850"
			 Padding="10"
			 x:Name="TrainTabItem"
			 x:DataType="vm:TrainingViewModel"
             x:Class="AutoTrainer.TrainingView"
             DataContext="{x:Static app:App.TrainingVM}">
	<Interaction.Behaviors>
		<EventTriggerBehavior EventName="Loaded">
			<InvokeCommandAction Command="{Binding LoadParamInfoCommand}"/>
		</EventTriggerBehavior>
	</Interaction.Behaviors>
	<Grid ColumnDefinitions=".3*,.65*">
		<Grid 
			Grid.Column="0"
			RowDefinitions=".3*,.65*,0.05*"
			Margin="0,0,10,0">
			<TextBox 
				Grid.Row="0" 
				BorderBrush="LightGray"
				BorderThickness="1"
				CornerRadius="5"
				UseFloatingWatermark="False" 
				Text="{Binding ModelParamStr}">
			</TextBox>
			<!--输出 output-->
			<TextBox
				x:Name="PyOutput_Tb"
				Grid.Row="1"
				Margin="0,10,0,0"
				BorderBrush="LightGray"
				BorderThickness="1"
				CornerRadius="5"
				FontFamily="Consolas"
				TextChanged="PyOutput_Tb_TextChanged"
				UseFloatingWatermark="False" 
				Text="{Binding PyOutput}"/>
			<Grid Grid.Row="2" ColumnDefinitions="*,*,*" VerticalAlignment="Center">
				<StackPanel Orientation="Horizontal" ToolTip.Tip="CPU占用率">
					<TextBlock Text="CPU利用率:"/>
					<TextBlock Margin="5,0,5,0" Text="{Binding CPURate}"/>
				</StackPanel>
				<StackPanel Grid.Column="1" Orientation="Horizontal" ToolTip.Tip="GPU占用率">
					<TextBlock Text="GPU利用率:"/>
					<TextBlock Margin="5,0,5,0" Text="{Binding GPURate}"/>
				</StackPanel>
				<StackPanel Grid.Column="2" Orientation="Horizontal" ToolTip.Tip="RAM占用率">
					<TextBlock Text="RAM利用率:"/>
					<TextBlock Margin="5,0,5,0" Text="{Binding RAMRate}"/>
				</StackPanel>
			</Grid>
		</Grid>
		<Grid 
			Grid.Column="1"
			Margin="10,0,0,0"
			RowDefinitions="Auto,50,6*,55">
			<Grid Grid.Row="0">
				<Button
					Grid.Row="0"
					Margin="10,0,10,0"
					IsVisible="{Binding IsShowNextPage}"
					Command="{Binding GotoNextPageCommand}"
					CommandParameter="{Binding ElementName=TrainTabItem}"
					HorizontalAlignment="Right"
					VerticalAlignment="Bottom">
					<StackPanel Orientation="Horizontal">
						<TextBlock
							Margin="0,0,10,0"
							FontSize="16"
							VerticalAlignment="Center"
							Text="下一步"/>
						<iconPacks:PackIconMaterial
							Width="16"
							Height="16"
							VerticalAlignment="Center"
							Kind="ChevronRight" />
					</StackPanel>
				</Button>
			</Grid>
			<Grid Grid.Row="1">
				<StackPanel Orientation="Vertical">
					<ProgressBar
						Margin="0,10,0,10"
						Height="10"
						Minimum="0"
						BorderThickness="1"
						Foreground="WhiteSmoke"
						Maximum="{Binding EpochState.TotalEpochs}"
						Value="{Binding EpochState.CurrentEpoch}" />
					<Grid ColumnDefinitions="*,*">
						<TextBlock
							Grid.Column="0"
							Text="训练进度"/>
						<TextBlock
							Grid.Column="1"
							HorizontalAlignment="Right">
							<TextBlock.Text>
								<MultiBinding StringFormat="{}{0}/{1}轮">
									<Binding Path="EpochState.CurrentEpoch" />
									<Binding Path="EpochState.TotalEpochs" />
								</MultiBinding>
							</TextBlock.Text>
						</TextBlock>
					</Grid>
				</StackPanel>
			</Grid>
			<Border 
				Grid.Row="2">
				<lvc:CartesianChart 
					Series="{Binding Series}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes}">
				</lvc:CartesianChart>
			</Border>
			<Grid Grid.Row="3">
				<StackPanel 
					HorizontalAlignment="Center"
					Orientation="Horizontal"
					VerticalAlignment="Center">
					<Button 
						Height="35"
						Content="开始训练"
						FontFamily="avares://AutoTrainer/Assets/Fonts#思源黑体 CN Bold"
						Command="{Binding StartTrainingCommand}"
						IsEnabled="{Binding !IsTraining}">
					</Button>
					<Button
						Height="35"
						Margin="10,0,0,0"
						Content="停止训练"
						FontFamily="avares://AutoTrainer/Assets/Fonts#思源黑体 CN Bold"
						Command="{Binding StopTrainingCommand}"
						IsEnabled="{Binding CanStopTraining}">
					</Button>
				</StackPanel>
			</Grid>
		</Grid>
	</Grid>
</UserControl>
