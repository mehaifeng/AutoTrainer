<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AutoTrainer.ViewModels"
			 xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
			 xmlns:ia="clr-namespace:Avalonia.Xaml.Interactions.Core;assembly=Avalonia.Xaml.Interactions"
			 xmlns:model="using:AutoTrainer.Models"
			 xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             mc:Ignorable="d"
             FontFamily=""
			 d:DesignWidth="1200"
			 d:DesignHeight="850"
			 Padding="10"
			 x:Name="TrainTabItem"
			 x:DataType="vm:TrainingViewModel"
             x:Class="AutoTrainer.TrainingView">
	<Interaction.Behaviors>
		<EventTriggerBehavior EventName="Loaded">
			<InvokeCommandAction Command="{Binding LoadParamInfoCommand}"/>
		</EventTriggerBehavior>
	</Interaction.Behaviors>
	<Grid ColumnDefinitions=".3*,.7*">
		<Grid 
			Grid.Column="0"
			RowDefinitions=".3*,.7*"
			Margin="0,0,10,0">
			<TextBox 
				Grid.Row="0" 
				BorderBrush="LightGray"
				BorderThickness="1"
				CornerRadius="5"
				UseFloatingWatermark="False" 
				Text="{Binding ModelParamStr}">
			</TextBox>
			<TextBox
				x:Name="PyOutput_Tb"
				Grid.Row="1"
				Margin="0,10,0,0"
				BorderBrush="LightGray"
				BorderThickness="1"
				CornerRadius="5"
				TextChanged="PyOutput_Tb_TextChanged"
				UseFloatingWatermark="False" 
				Text="{Binding PyOutput}"/>
		</Grid>
		<Grid 
			Grid.Column="1"
			Margin="10,0,0,0"
			RowDefinitions="Auto,50,6*,55">
			<Grid Grid.Row="0">
				<Button
					Grid.Row="0"
					Margin="10,0,10,0"
					Width="120"
					IsVisible="{Binding IsShowNextPage}"
					Command="{Binding GotoNextPageCommand}"
					CommandParameter="{Binding ElementName=TrainTabItem}"
					HorizontalAlignment="Right"
					VerticalAlignment="Center"
					Background="#FF080808"
					Foreground="White"
					BorderThickness="0"
					CornerRadius="16"
					Padding="16,8"
					FontWeight="SemiBold">
					<StackPanel Orientation="Horizontal">
						<Path Width="24" Height="24" Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z" Fill="White" VerticalAlignment="Center"/>
						<TextBlock
							Margin="10,0,0,0"
							FontSize="16"
							VerticalAlignment="Center"
							Text="下一步"/>
					</StackPanel>
				</Button>
			</Grid>
			<Grid Grid.Row="1">
				<StackPanel Orientation="Vertical">
					<ProgressBar
						Margin="0,10,0,10"
						Height="10"
						Minimum="0"
						BorderThickness="1"
						Foreground="WhiteSmoke"
						Maximum="{Binding EpochState.TotalEpochs}"
						Value="{Binding EpochState.CurrentEpoch}" />
					<Grid ColumnDefinitions="*,*">
						<TextBlock
							Grid.Column="0"
							Text="训练进度"/>
						<TextBlock
							Grid.Column="1"
							HorizontalAlignment="Right">
							<TextBlock.Text>
								<MultiBinding StringFormat="{}{0}/{1}轮">
									<Binding Path="EpochState.CurrentEpoch" />
									<Binding Path="EpochState.TotalEpochs" />
								</MultiBinding>
							</TextBlock.Text>
						</TextBlock>
					</Grid>
				</StackPanel>
			</Grid>
			<Border 
				Grid.Row="2">
				<lvc:CartesianChart 
					Series="{Binding Series}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes}">
				</lvc:CartesianChart>
			</Border>
			<Grid Grid.Row="3">
				<StackPanel 
					HorizontalAlignment="Center"
					Orientation="Horizontal"
					VerticalAlignment="Center">
					<Button 
						Height="35"
						Content="开始训练"
						FontFamily="avares://AutoTrainer/Assets/Fonts#思源黑体 CN Bold"
						Command="{Binding StartTrainingCommand}">
					</Button>
					<Button
						Height="35"
						Margin="10,0,0,0"
						Content="暂停">
					</Button>
					<Button Height="35" Margin="10,0,0,0" Content="停止"/>
				</StackPanel>
			</Grid>
		</Grid>
	</Grid>
</UserControl>
