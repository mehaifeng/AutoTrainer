<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
			 xmlns:vm="using:AutoTrainer.ViewModels"
			 xmlns:notification="clr-namespace:Avalonia.Notification.Controls;assembly=Notification.Avalonia"
			 d:DesignWidth="1200"
			 d:DesignHeight="850"
			 x:Name="ConverterView"
			 x:DataType="vm:ModelExportViewModel"
             x:Class="AutoTrainer.ModelExportView">
	
	<Panel>
		<!-- 通知容器 -->
		<notification:NotificationMessageContainer Manager="{Binding NotifyManager}" ZIndex="999"/>
		<!-- 主内容 -->
		<Grid Margin="20">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="380"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>
		<!-- 左侧配置区域 -->
		<ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
			<StackPanel Spacing="15">

				<!-- 模型源配置 -->
				<Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="15">
					<StackPanel Spacing="10">
						<TextBlock Text="模型源配置" FontWeight="Bold" FontSize="14"/>

						<TextBlock Text="待转换模型路径" Foreground="#666" FontSize="12" Margin="0,5,0,0"/>
						<Grid ColumnDefinitions="*,Auto">
							<TextBox Grid.Column="0"
                                   Text="{Binding ModelPath}"
                                   IsReadOnly="True"/>
							<Button Grid.Column="1"
                                  Content="..."
                                  Width="40"
                                  Margin="5,0,0,0"
                                  Command="{Binding BrowseModelFileCommand}"/>
						</Grid>

						<TextBlock Text="模型架构名称（从 metadata 自动读取）" Foreground="#666" FontSize="12" Margin="0,10,0,0"/>
						<TextBox Text="{Binding ModelName}" 
						         IsReadOnly="True"
						         Watermark="选择模型后自动读取"/>
						
						<!-- 模型名称状态提示 -->
						<TextBlock Text="{Binding ModelNameStatus}" 
						          Foreground="#999" 
						          FontSize="11" 
						          Margin="0,3,0,0"/>
					</StackPanel>
				</Border>

				<!-- 导出格式选择 -->
				<Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="15">
					<StackPanel Spacing="12">
						<TextBlock Text="导出格式选择" FontWeight="Bold" FontSize="14"/>

						<!-- 通用格式 -->
						<TextBlock Text="通用格式" Foreground="#888" FontSize="11" Margin="0,5,0,0"/>

						<CheckBox Content="ONNX 格式" IsChecked="{Binding ConversionTasks[0].IsSelected}"/>
						<StackPanel Margin="25,3,0,0" Spacing="6">
							<Grid ColumnDefinitions="Auto,*">
								<TextBlock Grid.Column="0" Text="Opset 版本" Foreground="#666" FontSize="11" VerticalAlignment="Center"/>
								<ComboBox Grid.Column="1" Width="150" HorizontalAlignment="Left" Margin="10,0,0,0" SelectedIndex="{Binding OpsetVersion}">
									<ComboBoxItem Content="opset 11"/>
									<ComboBoxItem Content="opset 13"/>
									<ComboBoxItem Content="opset 15 (推荐)"/>
								</ComboBox>
							</Grid>
						</StackPanel>

						<CheckBox Content="TorchScript 格式" IsChecked="{Binding ConversionTasks[1].IsSelected}" Margin="0,8,0,0"/>

						<!-- 硬件优化格式 -->
						<Separator Background="#E0E0E0" Height="1" Margin="0,8,0,0"/>
						<TextBlock Text="硬件优化格式" Foreground="#888" FontSize="11"/>

						<CheckBox Content="TensorRT 格式 (NVIDIA GPU)" IsChecked="{Binding ConversionTasks[2].IsSelected}"/>
						<TextBlock Text="需要 NVIDIA GPU 和 TensorRT 运行时"
                                 Foreground="#999"
                                 FontSize="10"
                                 Margin="25,2,0,0"/>

						<CheckBox Content="OpenVINO 格式 (Intel 硬件)" IsChecked="{Binding ConversionTasks[3].IsSelected}" Margin="0,8,0,0"/>
						<TextBlock Text="适用于 Intel CPU/GPU/VPU"
                                 Foreground="#999"
                                 FontSize="10"
                                 Margin="25,2,0,0"/>

						<CheckBox Content="Core ML 格式 (iOS/macOS)" IsChecked="{Binding ConversionTasks[4].IsSelected}" Margin="0,8,0,0"/>
						<TextBlock Text="适用于 Apple 设备部署"
                                 Foreground="#999"
                                 FontSize="10"
                                 Margin="25,2,0,0"/>
					</StackPanel>
				</Border>

				<!-- 导出配置 -->
				<Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="15">
					<StackPanel Spacing="10">
						<TextBlock Text="导出配置" FontWeight="Bold" FontSize="14"/>

						<TextBlock Text="输出目录" Foreground="#666" FontSize="12" Margin="0,5,0,0"/>
						<Grid ColumnDefinitions="*,Auto">
							<TextBox Grid.Column="0"
                                   Text="{Binding OutputDirectory}"/>
							<Button Grid.Column="1"
                                  Content="..."
                                  Width="40"
                                  Margin="5,0,0,0"
                                  
                                  Command="{Binding BrowseOutputDirectoryCommand}"/>
						</Grid>

						<CheckBox Content="优化模型 (仅ONNX)" IsChecked="{Binding OptimizeModel}" Margin="0,10,0,0"/>
						<TextBlock 
							Text="使用 onnxslim 优化计算图，提升兼容性和推理效率"
                            Foreground="#999"
                            FontSize="10"
                            Margin="25,2,0,0"
                            TextWrapping="Wrap"/>
						<CheckBox Content="导出后自动验证" IsChecked="{Binding AutoValidate}" IsEnabled="False" Margin="0,8,0,0"/>
						<TextBlock 
							Text="此功能开发中..."
                            Foreground="#999"
                            FontSize="10"
                            Margin="25,0,0,0"/>
					</StackPanel>
				</Border>

				<!-- 高级参数 -->
				<Expander Header="高级参数" IsExpanded="False" HorizontalAlignment="Stretch">
					<Border 
                        Padding="15">
						<StackPanel Spacing="10">

							<TextBlock Text="输入尺寸 (示例输入)" Foreground="#666" FontSize="12"/>
							<TextBlock Text="通常从训练配置自动获取，如需覆盖请手动修改"
                                     Foreground="#999"
                                     FontSize="10"
                                     Margin="0,0,0,5"
                                     TextWrapping="Wrap"/>
							<Grid ColumnDefinitions="*,Auto,*,Auto,*">
								<StackPanel Grid.Column="0">
									<TextBlock Text="Batch" Foreground="#999" FontSize="10" HorizontalAlignment="Center"/>
									<TextBox Text="{Binding BatchSize}" TextAlignment="Center" Margin="0,2,0,0"/>
								</StackPanel>
								<TextBlock Grid.Column="1" Text="×" Margin="5,12,5,0" VerticalAlignment="Center" Foreground="#CCC"/>
								<StackPanel Grid.Column="2">
									<TextBlock Text="Channels" Foreground="#999" FontSize="10" HorizontalAlignment="Center"/>
									<TextBox Text="{Binding Channels}" TextAlignment="Center" Margin="0,2,0,0"/>
								</StackPanel>
								<TextBlock Grid.Column="3" Text="×" Margin="5,12,5,0" VerticalAlignment="Center" Foreground="#CCC"/>
								<StackPanel Grid.Column="4">
									<TextBlock Text="H × W" Foreground="#999" FontSize="10" HorizontalAlignment="Center"/>
									<TextBox Text="{Binding ImageSize}" TextAlignment="Center" Margin="0,2,0,0"/>
								</StackPanel>
							</Grid>

							<Separator Background="#E0E0E0" Height="1" Margin="0,10"/>

							<CheckBox Content="包含预处理步骤" IsChecked="{Binding IncludePreprocessing}"/>
							<TextBlock 
								Text="将 resize、归一化等预处理嵌入到导出的模型中"
                                Foreground="#999"
                                FontSize="10"
                                Margin="25,0,0,0"
                                TextWrapping="Wrap"/>

							<CheckBox Content="支持动态输入尺寸 (仅ONNX)" IsChecked="{Binding DynamicInputSize}" Margin="0,8,0,0"/>
							<TextBlock 
								Text="允许 ONNX 模型使用不同的 batch_size（如 1/4/8/16）"
                                Foreground="#999"
                                FontSize="10"
                                Margin="25,0,0,0"
                                TextWrapping="Wrap"/>
						</StackPanel>
					</Border>
				</Expander>

				<!-- 操作按钮 -->
				<Grid ColumnDefinitions="*,*" Margin="0,10,0,0">
					<Button 
						Grid.Column="0"
                        Content="开始转换"
                        Height="35"
                        Margin="0,0,5,0"
						VerticalContentAlignment="Center"
                        HorizontalContentAlignment="Center"
                        Command="{Binding StartConversionCommand}"
                        IsEnabled="{Binding !IsConverting}"/>
					<Button 
						Grid.Column="1"
                        Content="取消"
                        Height="35"
                        Margin="5,0,0,0"
                        HorizontalContentAlignment="Center"
						VerticalContentAlignment="Center"
                        Command="{Binding CancelConversionCommand}"
                        IsEnabled="{Binding IsConverting}"/>
				</Grid>

			</StackPanel>
		</ScrollViewer>

		<!-- 右侧显示区域 -->
		<Border Grid.Column="1"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="4"
                Margin="15,0,0,0">
			<Grid Margin="20">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<!-- 标题区域 -->
				<StackPanel Grid.Row="0" Spacing="10">
					<TextBlock Text="转换进度" FontSize="16" FontWeight="Bold"/>
				</StackPanel>

				<!-- 进度显示区域 -->
				<ScrollViewer Grid.Row="1" Margin="0,20,0,10" VerticalScrollBarVisibility="Auto">
					<ItemsControl ItemsSource="{Binding ConversionTasks}">
						<ItemsControl.ItemTemplate>
							<!--各个模型格式的导出区域-->
							<DataTemplate>
								<Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="15" Margin="0,0,0,15">
									<StackPanel Spacing="10">
										<Grid ColumnDefinitions="Auto,*,Auto,Auto">
											<Border Grid.Column="0"
                                                  Background="{Binding BadgeColor}"
                                                  CornerRadius="3"
                                                  Padding="6,2"
                                                  Margin="0,0,10,0">
												<TextBlock 
													Text="{Binding FormatName, Converter={StaticResource StringUpperCaseConverter}}"
                                                    Foreground="White"
                                                    FontSize="10"
                                                    FontWeight="Bold"/>
											</Border>
											<TextBlock
												Grid.Column="1"
                                                Text="{Binding DisplayName}"
                                                FontWeight="SemiBold"
                                                VerticalAlignment="Center"/>
											<TextBlock 
												Grid.Column="2"
                                                Text="{Binding StatusText}"
                                                Foreground="#999"
                                                FontSize="12"
                                                Margin="0,0,10,0"
                                                VerticalAlignment="Center"/>
											<TextBlock 
												Grid.Column="3"
                                                Text="{Binding Progress, StringFormat={}{0:F0}%}"
                                                Foreground="#666"
                                                FontSize="12"
                                                VerticalAlignment="Center"/>
										</Grid>
										<ProgressBar 
											Value="{Binding Progress}"
                                            Height="6"
                                            Foreground="{Binding ProgressColor}"
                                            CornerRadius="3"/>
										<TextBlock 
											Text="{Binding OutputPath}"
                                            Foreground="#666"
                                            FontSize="11"/>
										<TextBox 
											VerticalAlignment="Stretch"
											MaxHeight="300"
											Text="{Binding LogText}"
                                            Background="Transparent"
                                            IsReadOnly="True"
                                            TextWrapping="Wrap"
                                            FontFamily="Consolas"
                                            FontSize="10"
                                            Foreground="#666"/>
									</StackPanel>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</ScrollViewer>
				<!-- 底部统计信息 -->
				<Border Grid.Row="2"
						BorderBrush="#666"
						BorderThickness="1"
                      CornerRadius="4"
                      Padding="15">
					<Grid ColumnDefinitions="*,*,*,*,*">
						<StackPanel Grid.Column="0">
							<TextBlock Text="转换状态" Foreground="#666" FontSize="11"/>
							<TextBlock Text="{Binding ConversionStatus}" FontWeight="SemiBold" FontSize="13" Margin="0,3,0,0"/>
						</StackPanel>
						<StackPanel Grid.Column="1">
							<TextBlock Text="已完成" Foreground="#666" FontSize="11"/>
							<TextBlock Text="{Binding CompletedCount}" FontWeight="SemiBold" FontSize="13" Margin="0,3,0,0"/>
						</StackPanel>
						<StackPanel Grid.Column="2">
							<TextBlock Text="成功/失败" Foreground="#666" FontSize="11"/>
							<TextBlock Text="{Binding SuccessFailCount}" FontWeight="SemiBold" FontSize="13" Margin="0,3,0,0"/>
						</StackPanel>
						<StackPanel Grid.Column="3">
							<TextBlock Text="总耗时" Foreground="#666" FontSize="11"/>
							<TextBlock Text="{Binding ElapsedTime}" FontWeight="SemiBold" FontSize="13" Margin="0,3,0,0"/>
						</StackPanel>
						<StackPanel Grid.Column="4">
							<TextBlock Text="输出文件" Foreground="#666" FontSize="11"/>
							<TextBlock Text="{Binding OutputFileCount}" FontWeight="SemiBold" FontSize="13" Margin="0,3,0,0"/>
						</StackPanel>
					</Grid>
				</Border>

			</Grid>
		</Border>
	</Grid>
	</Panel>
</UserControl>
