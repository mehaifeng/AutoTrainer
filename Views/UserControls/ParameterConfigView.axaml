<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:p1="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
			 xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
			 xmlns:controls="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
			 xmlns:vm="using:AutoTrainer.ViewModels"
			 xmlns:converters="using:AutoTrainer.Converters"
			 xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
             xmlns:ia="clr-namespace:Avalonia.Xaml.Interactions.Core;assembly=Avalonia.Xaml.Interactions" 
             mc:Ignorable="d"
			 Padding="5"
			 d:DesignWidth="1200"
			 d:DesignHeight="850"
			 x:Name="ParameterPage"
			 x:DataType="vm:ParameterConfigViewModel"
             x:Class="AutoTrainer.ParameterConfigView">
	<UserControl.Resources>
		<converters:LossFunctionUIConverter x:Key="StringEqualsConverter"/>
	</UserControl.Resources>
	<Grid RowDefinitions="60,*">
		<Grid Grid.Row="0">
			<StackPanel
				HorizontalAlignment="Right"
				VerticalAlignment="Center"
				Orientation="Horizontal">
				<Button
					Classes="light"
					Height="35"
					Content="重设配置" />
				<Button
					Classes="light"
					Height="35"
					Margin="10,0,10,0"
					Command="{Binding SaveConfigCommand}"
					Content="保存配置" />
				<controls:FloatingButton
					Grid.Row="0"
					Command="{Binding GoToNextTabCommand}"
					CommandParameter="{Binding ElementName=ParameterPage}"
					
					Margin="10,0,10,0"
					Width="120"
					HorizontalAlignment="Right"
					VerticalAlignment="Center"
					IsVisible="{Binding IsVisibleNextStep}"
					Classes="Light"
					IsExtended="True">
					<controls:FloatingButton.Styles>
						<Style Selector="controls|FloatingButton">
							<Setter Property="Content">
								<Setter.Value>
									<Template>
										<StackPanel Orientation="Horizontal">
											<Viewbox Stretch="None"
													 HorizontalAlignment="Left"
													 VerticalAlignment="Center">
												<avalonia:MaterialIcon Kind="ChevronRight" Width="24" Height="24" />
											</Viewbox>
											<TextBlock
												Margin="10,0,0,0"
												FontSize="16"
												HorizontalAlignment="Center"
												VerticalAlignment="Center"
												Text="下一步"/>
										</StackPanel>
									</Template>
								</Setter.Value>
							</Setter>
						</Style>
					</controls:FloatingButton.Styles>
				</controls:FloatingButton>
			</StackPanel>
		</Grid>
		<Grid 
			Grid.Row="1"
			Margin="15,0,0,0"
			ColumnDefinitions="*,20,*">
			<Grid
				Grid.Column="0"
				Height="450"
				Margin="0,20,0,0"
				VerticalAlignment="Top"
				RowDefinitions="20,80,80,80,80,80,210">
				<TextBlock 
					Grid.Row="0" 
					Margin="0,0,0,30"
					Width="65"
					TextAlignment="Center"
					HorizontalAlignment="Left"
					Foreground="White"
					Background="Black"
					Text="基础参数"
					FontWeight="Bold"/>
				<ComboBox 
					Grid.Row="1"
					Margin="0,0,0,20"
					ItemsSource="{Binding LearningRates}"
					SelectedItem="{Binding SelectedLearningRate}"
					Theme="{StaticResource MaterialOutlineComboBox}" 
					p1:ComboBoxAssist.Label="学习率" />
				<ComboBox
					Grid.Row="2"
					Margin="0,0,0,20"
					ItemsSource="{Binding BatchSizes}"
					SelectedItem="{Binding SelectedBatchSize}"
					Theme="{StaticResource MaterialOutlineComboBox}"
					p1:ComboBoxAssist.Label="Batch Size" />
				<StackPanel	
					Grid.Row="3"
					Margin="0,0,0,20" 
					Orientation="Vertical">
					<TextBlock Text="训练轮数"/>
				<NumericUpDown
					Increment="1"
					Text="1"
					Value="{Binding Epochs}"
					Watermark="训练轮数"
					Theme="{StaticResource OutlineNumericUpDown}"/>
				</StackPanel>
				<ComboBox
					Grid.Row="4"
					Margin="0,0,0,20"
					ItemsSource="{Binding Optimizers}"
					SelectedItem="{Binding SelectedOptimizer}"
					Theme="{StaticResource MaterialOutlineComboBox}"
					p1:ComboBoxAssist.Label="优化器" />
				<ComboBox
					Grid.Row="5"
					ItemsSource="{Binding ValidationSetRates}"
					SelectedItem="{Binding SelectedValidationSetRate}"
					SelectedIndex="1"
					Theme="{StaticResource MaterialOutlineComboBox}"
					p1:ComboBoxAssist.Label="验证集比例" />
				<Grid
					Grid.Row="6"
					RowDefinitions="35,Auto">
					<TextBlock
						Width="65"
						FontWeight="Bold"
						TextAlignment="Center"
						VerticalAlignment="Center"
						HorizontalAlignment="Left"
						Text="数据增强"/>
					<Border
						Grid.Row="1"
						CornerRadius="5"
						BorderThickness="1"
						Padding="8"
						BorderBrush="LightGray">
						<StackPanel Orientation="Vertical">
							<CheckBox
								Margin="0,0,0,0"
								IsChecked="{Binding RandomHorizonFlipChecked}"
								Content="随机水平翻转"/>
							<CheckBox
								Margin="0,5,0,0"
								IsChecked="{Binding RandomVerticalFlipChecked}"
								Content="随机垂直翻转"/>
							<CheckBox
								Margin="0,5,0,0"
								IsChecked="{Binding RandomRotationChecked}"
								Content="随机旋转"/>
							<CheckBox
								Margin="0,5,0,0"
								IsChecked="{Binding RandomZoomChecked}"
								Content="随机缩放"/>
							<CheckBox
								Margin="0,5,0,0"
								IsChecked="{Binding RandomBrightnessChecked}"
								Content="随机亮度"/>
							<CheckBox
								Margin="0,5,0,0"
								IsChecked="{Binding RandomContrastChecked}"
								Content="随机对比度"/>
						</StackPanel>
					</Border>
				</Grid>
			</Grid>
			<Grid 
				Grid.Column="2"
				RowDefinitions="20,*"
				Margin="0,20,0,0">
				<TextBlock
					Grid.Row="0"
					Margin="0,0,0,30"
					Width="65"
					TextAlignment="Center"
					HorizontalAlignment="Left"
					Foreground="White"
					Background="Black"
					Text="高级参数"
					FontWeight="Bold"/>
				<ScrollViewer Grid.Row="1" Padding="0,0,10,0" Margin="0,0,0,30">
					<Grid RowDefinitions="80,80,80,80,*">
						<!--学习率调度策略-->
						<ComboBox
							Grid.Row="0"
							Margin="0,0,0,20"
							ItemsSource="{Binding SchedulingStrategies}"
							SelectedItem="{Binding SelectedStrategy,StringFormat={}{0:P1}}"
							Theme="{StaticResource MaterialOutlineComboBox}"
							p1:ComboBoxAssist.Label="学习率调度策略" />
						<!--权重衰减-->
						<StackPanel
							Grid.Row="1"
							Margin="0,0,0,20"
							Orientation="Vertical">
							<TextBlock Text="权重衰减"/>
							<NumericUpDown
								Increment="0.0001"
								Value="{Binding WeightDecay}"
								Theme="{StaticResource OutlineNumericUpDown}"
								Watermark="权重衰减" />
						</StackPanel>
						<!--早停轮数-->
						<StackPanel
							Grid.Row="2"
							Margin="0,0,0,20"
							Orientation="Vertical">
							<TextBlock Text="早停轮数"/>
							<NumericUpDown
								Increment="1"
								Value="{Binding EarlyStopRound}"
								Theme="{StaticResource OutlineNumericUpDown}"
								Watermark="早停轮数" />
						</StackPanel>
						<!--早停阈值-->
						<StackPanel
							Grid.Row="3"
							Margin="0,0,0,20"
							Orientation="Vertical">
							<TextBlock Text="早停阈值"/>
							<NumericUpDown
								Increment="0.0001"
								Value="{Binding EarlyStopDelta}"
								Theme="{StaticResource OutlineNumericUpDown}"
								Watermark="早停阈值" />
						</StackPanel>
						<!--损失函数配置-->
						<Grid Grid.Row="4" RowDefinitions="20,*">
							<TextBlock
								Grid.Row="0"
								Width="88"
								TextAlignment="Center"
								HorizontalAlignment="Left"
								VerticalAlignment="Top"
								Text="损失函数配置"
								FontWeight="Bold"/>
							<Border
								Grid.Row="1"
								Background="WhiteSmoke"
								BorderBrush="LightGray"
								BorderThickness="1"
								CornerRadius="5"
								Padding="10">
								<Grid RowDefinitions="80,20,Auto,Auto">
									<ComboBox
										Name="LossFunction"
										Grid.Row="0"
										ItemsSource="{Binding LossFunctionTypes}"
										Theme="{StaticResource MaterialOutlineComboBox}"
										SelectedItem="{Binding SelectedLossFunction}"
										p1:ComboBoxAssist.Label="选择损失函数">
									</ComboBox>
									<TextBlock
										Name="TipText"
										Text="{Binding LossFunctionDescribe}"
										Grid.Row="1">
										<TextBlock.Styles>
											<Style Selector="TextBlock">
												<Setter Property="FontSize" Value="12"/>
												<Setter Property="Foreground" Value="Gray"/>
											</Style>
										</TextBlock.Styles>
									</TextBlock>
									<Grid Grid.Row="2" Name="LossFunctionParamsGrid">
										<!-- CrossEntropyLoss 参数配置 -->
										<Grid IsVisible="{Binding ElementName=LossFunction, Path=SelectedItem, Converter={StaticResource StringEqualsConverter}, ConverterParameter=CrossEntropyLoss}"
											  RowDefinitions="80,80,80">
											<StackPanel Grid.Row="0" Margin="0,10,0,0" Orientation="Vertical">
												<StackPanel Orientation="Horizontal">
													<TextBlock Text="weight"/>
													<TextBlock Margin="10,0,0,0" FontSize="12" Foreground="Gray" Text="各类别的权重，用于处理类别不平衡，格式如: 1.0,2.0,1.0"/>
												</StackPanel>
												<TextBox 
													Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
													Name="CrossEntropyWeights"
													Classes="outline"
													UseFloatingWatermark="False"
													Text="{Binding Weight,Mode=OneWayToSource,UpdateSourceTrigger=PropertyChanged}"
													Theme="{StaticResource OutlineTextBox}"
													Watermark="留空表示所有类别权重相等">
												</TextBox>
											</StackPanel>
											<StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,15,0,0">
												<StackPanel Orientation="Horizontal">
													<TextBlock Text="label_smoothing"/>
													<TextBlock Margin="10,0,0,0" FontSize="12" Foreground="Gray" Text="标签平滑因子，用于提高模型泛化能力"/>
												</StackPanel>
												<NumericUpDown
													Margin="0,10,0,0"
													Height="50"
													Value="{Binding LabelSmoothing}"
													Increment="0.1"
													Maximum="1"
													Minimum="0"
													Theme="{StaticResource OutlineNumericUpDown}">
												</NumericUpDown>
											</StackPanel>
											<ComboBox Grid.Row="2"  Margin="0,10,0,0"
													  Name="CrossEntropyReduction"
													  ItemsSource="{Binding Reductions}"
													  SelectedItem="{Binding SelectedReduction}"
													  Theme="{StaticResource MaterialOutlineComboBox}"
													  SelectedIndex="0"
													  p1:ComboBoxAssist.Label="reduction 损失计算方式">
											</ComboBox>
										</Grid>

										<!-- BCELoss 参数配置 -->
										<Grid IsVisible="{Binding ElementName=LossFunction, Path=SelectedItem, Converter={StaticResource StringEqualsConverter}, ConverterParameter=BCELoss}"
											  RowDefinitions="Auto,Auto" Margin="0,10">
											<StackPanel Grid.Row="0" Orientation="Vertical">
												<StackPanel Orientation="Horizontal">
													<TextBlock Text="weight"/>
													<TextBlock Margin="10,0,0,0" FontSize="12" Foreground="Gray" Text="每个批次样本的权重，用逗号分隔"/>
												</StackPanel>
												<TextBox
													Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
													Name="BCELossWeights"
													Classes="outline"
													Text="{Binding Weight}"
													UseFloatingWatermark="False"
													Theme="{StaticResource OutlineTextBox}"
													Watermark="留空表示所有类别权重相等">
												</TextBox>
											</StackPanel>
											<ComboBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0"
													  Name="BCEReduction"
													  ItemsSource="{Binding Reductions}"
													  SelectedItem="{Binding SelectedReduction}"
													  Theme="{StaticResource MaterialOutlineComboBox}"
													  SelectedIndex="0"
													  p1:ComboBoxAssist.Label="reduction 损失计算方式">
											</ComboBox>
										</Grid>

										<!-- BCEWithLogitsLoss 参数配置 -->
										<Grid IsVisible="{Binding ElementName=LossFunction, Path=SelectedItem, Converter={StaticResource StringEqualsConverter}, ConverterParameter=BCEWithLogitsLoss}"
											  RowDefinitions="Auto,Auto,Auto">
											<StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,10,0,0">
												<StackPanel Orientation="Horizontal">
													<TextBlock Text="weight"/>
													<TextBlock Margin="10,0,0,0" FontSize="12" Foreground="Gray" Text="每个批次样本的权重"/>
												</StackPanel>
												<TextBox
													Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
													Name="BCEWithLogitsLossWeights"
													Classes="outline"
													UseFloatingWatermark="False"
													Text="{Binding Weight}"
													Theme="{StaticResource OutlineTextBox}"
													Watermark="留空表示所有类别权重相等">
												</TextBox>
											</StackPanel>

											<StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,10,0,0">
												<StackPanel Orientation="Horizontal">
													<TextBlock Text="pos_weight"/>
													<TextBlock Margin="10,0,0,0" FontSize="12" Foreground="Gray" Text="正样本的权重，用于处理类别不平衡"/>
												</StackPanel>
												<TextBox
													Grid.ColumnSpan="2"
													Name="BCEWithLogitsLossPosWeight"
													Classes="outline"
													Text="{Binding Pos_weight}"
													UseFloatingWatermark="False"
													Theme="{StaticResource OutlineTextBox}"
													Watermark="留空表示所有类别权重为1"/>
											</StackPanel>
											<ComboBox Grid.Row="2" Grid.Column="0" Margin="0,10,0,0"
													  Name="BCELogitsReduction"
													  Theme="{StaticResource MaterialOutlineComboBox}"
													  ItemsSource="{Binding Reductions}"
													  SelectedItem="{Binding SelectedReduction}"
													  p1:ComboBoxAssist.Label="reduction 损失计算方式">
											</ComboBox>
										</Grid>

										<!-- MSELoss 参数配置 -->
										<Grid IsVisible="{Binding ElementName=LossFunction, Path=SelectedItem, Converter={StaticResource StringEqualsConverter}, ConverterParameter=MSELoss}"
											  RowDefinitions="Auto" ColumnDefinitions="*,*" Margin="0,10">
											<ComboBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,5"
													  Name="MSEReduction"
													  ItemsSource="{Binding Reductions}"
													  Theme="{StaticResource MaterialOutlineComboBox}"
													  SelectedItem="{Binding SelectedReduction}"
													  p1:ComboBoxAssist.Label="损失计算方式">
											</ComboBox>
										</Grid>

										<!-- L1Loss 参数配置 -->
										<Grid IsVisible="{Binding ElementName=LossFunction, Path=SelectedItem, Converter={StaticResource StringEqualsConverter}, ConverterParameter=L1Loss}"
											  RowDefinitions="Auto" ColumnDefinitions="*,*" Margin="0,10">
											<ComboBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,5"
													  Name="L1Reduction"
													  Theme="{StaticResource MaterialOutlineComboBox}"
													  ItemsSource="{Binding Reductions}"
													  SelectedItem="{Binding SelectedReduction}"
													  p1:ComboBoxAssist.Label="损失计算方式">
											</ComboBox>
										</Grid>

										<!-- SmoothL1Loss 参数配置 -->
										<Grid IsVisible="{Binding ElementName=LossFunction, Path=SelectedItem, Converter={StaticResource StringEqualsConverter}, ConverterParameter=SmoothL1Loss}"
											  RowDefinitions="Auto,Auto" Margin="0,10">
											<StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,10,0,0">
												<StackPanel Orientation="Horizontal">
													<TextBlock Text="Beta"/>
													<TextBlock Margin="10,0,0,0" FontSize="12" Foreground="Gray" Text="平滑参数，决定MSE和L1的过渡点"/>
												</StackPanel>
												<NumericUpDown
													Margin="0,10,0,0"
													Height="50"
													Value="{Binding Beta}"
													Increment="0.1"
													Minimum="0"
													Theme="{StaticResource OutlineNumericUpDown}"/>
											</StackPanel>
											<ComboBox Grid.Row="1" Margin="0,15,0,0"
													  Name="SmoothL1Reduction"
													  Theme="{StaticResource MaterialOutlineComboBox}"
													  ItemsSource="{Binding Reductions}"
													  SelectedItem="{Binding SelectedReduction}"
													  p1:ComboBoxAssist.Label="损失计算方式">
											</ComboBox>
										</Grid>

										<!-- KLDivLoss 参数配置 -->
										<Grid IsVisible="{Binding ElementName=LossFunction, Path=SelectedItem, Converter={StaticResource StringEqualsConverter}, ConverterParameter=KLDivLoss}"
											  RowDefinitions="Auto" ColumnDefinitions="*,*" Margin="0,10">
											<ComboBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,5"
													  Name="KLDivReduction"
													  Theme="{StaticResource MaterialOutlineComboBox}"
													  ItemsSource="{Binding KLDivLoss_Reductions}"
													  SelectedItem="{Binding SelectedReduction}"
													  p1:ComboBoxAssist.Label="损失计算方式">
											</ComboBox>
										</Grid>
									</Grid>

									<StackPanel Grid.Row="3" Orientation="Vertical" Margin="0,10,0,0">
										<TextBlock Text="参数预览"/>
										<Border CornerRadius="5" Background="AliceBlue" Margin="0,10,0,0" Padding="10">
											<SelectableTextBlock 
												MinHeight="180"
												SelectionForegroundBrush="White"
												Text="{Binding CodePreview}"/>
										</Border>
									</StackPanel>
								</Grid>
							</Border>
						</Grid>
					</Grid>
				</ScrollViewer>
			</Grid>
		</Grid>
	</Grid>
</UserControl>
