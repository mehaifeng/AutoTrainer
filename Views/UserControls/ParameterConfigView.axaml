<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="using:AutoTrainer.ViewModels"
			 xmlns:converters="using:AutoTrainer.Converters"
			 xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
             xmlns:ia="clr-namespace:Avalonia.Xaml.Interactions.Core;assembly=Avalonia.Xaml.Interactions"
             mc:Ignorable="d"
			 Padding="5"
			 d:DesignWidth="1200"
			 d:DesignHeight="850"
			 x:Name="ParameterPage"
			 x:DataType="vm:ParameterConfigViewModel"
             x:Class="AutoTrainer.ParameterConfigView">
	<UserControl.Resources>
		<converters:LossFunctionUIConverter x:Key="StringEqualsConverter"/>
	</UserControl.Resources>
	<UserControl.Styles>
		<Style Selector="Button.light">
			<Setter Property="Background" Value="#FFF5F5F5"/>
			<Setter Property="BorderBrush" Value="#FFE0E0E0"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Foreground" Value="#FF333333"/>
		</Style>
		<Style Selector="Button.light:pointerover">
			<Setter Property="Background" Value="#FFE8E8E8"/>
			<Setter Property="BorderBrush" Value="#FFD0D0D0"/>
		</Style>
		<Style Selector="Button.floating">
			<Setter Property="Background" Value="#FF080808"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="CornerRadius" Value="16"/>
			<Setter Property="Padding" Value="16,8"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
		</Style>
		<Style Selector="Button.floating:pointerover">
			<Setter Property="Background" Value="#FF333333"/>
		</Style>
		<Style Selector="Button.floating:pressed">
			<Setter Property="Background" Value="#FF000000"/>
		</Style>
		<Style Selector="ComboBox.outline">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="#FF080808"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Foreground" Value="#FF080808"/>
		</Style>
		<Style Selector="ComboBox.outline:focus">
			<Setter Property="BorderBrush" Value="#FF007ACC"/>
		</Style>
		<Style Selector="NumericUpDown.outline">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="#FF080808"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Foreground" Value="#FF080808"/>
		</Style>
		<Style Selector="NumericUpDown.outline:focus">
			<Setter Property="BorderBrush" Value="#FF007ACC"/>
		</Style>
		<Style Selector="TextBox.outline">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="#FF080808"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Foreground" Value="#FF080808"/>
		</Style>
		<Style Selector="TextBox.outline:focus">
			<Setter Property="BorderBrush" Value="#FF007ACC"/>
		</Style>
	</UserControl.Styles>
	<Grid RowDefinitions="60,*">
		<Grid Grid.Row="0">
			<StackPanel
				HorizontalAlignment="Right"
				VerticalAlignment="Center"
				Orientation="Horizontal">
				<Button
					Classes="light"
					Height="35"
					Content="重设配置" />
				<Button
					Classes="light"
					Height="35"
					Margin="10,0,10,0"
					Command="{Binding SaveConfigCommand}"
					Content="保存配置" />
				<Button
					Grid.Row="0"
					Command="{Binding GoToNextTabCommand}"
					CommandParameter="{Binding ElementName=ParameterPage}"
					Margin="10,0,10,0"
					Width="120"
					HorizontalAlignment="Right"
					VerticalAlignment="Center"
					IsVisible="{Binding IsVisibleNextStep}"
					Classes="floating">
					<StackPanel Orientation="Horizontal">
						<Path Width="24" Height="24" Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z" Fill="White" VerticalAlignment="Center"/>
						<TextBlock
							Margin="10,0,0,0"
							FontSize="16"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							Foreground="White"
							Text="下一步"/>
					</StackPanel>
				</Button>
			</StackPanel>
		</Grid>
		<Grid
			Grid.Row="1"
			Margin="15,0,0,0"
			ColumnDefinitions="*,20,*">
			<Grid
				Grid.Column="0"
				Height="450"
				Margin="0,20,0,0"
				VerticalAlignment="Top"
				RowDefinitions="20,100,100,100,100,100,210">
				<TextBlock
					Grid.Row="0"
					Margin="0,0,0,30"
					Width="65"
					TextAlignment="Center"
					HorizontalAlignment="Left"
					Foreground="White"
					Background="Black"
					Text="基础参数"
					FontWeight="Bold"/>
				<StackPanel Grid.Row="1" Margin="0,0,0,20">
					<TextBlock Text="学习率" Margin="0,0,0,5" FontSize="12" FontWeight="SemiBold"/>
					<ComboBox
						ItemsSource="{Binding LearningRates}"
						SelectedItem="{Binding SelectedLearningRate}"
						Classes="outline" />
				</StackPanel>
				<StackPanel Grid.Row="2" Margin="0,0,0,20">
					<TextBlock Text="Batch Size" Margin="0,0,0,5" FontSize="12" FontWeight="SemiBold"/>
					<ComboBox
						ItemsSource="{Binding BatchSizes}"
						SelectedItem="{Binding SelectedBatchSize}"
						Classes="outline" />
				</StackPanel>
				<StackPanel
					Grid.Row="3"
					Margin="0,0,0,20"
					Orientation="Vertical">
					<TextBlock Text="训练轮数" Margin="0,0,0,5" FontSize="12" FontWeight="SemiBold"/>
					<NumericUpDown
						Increment="1"
						Text="1"
						Value="{Binding Epochs}"
						Watermark="训练轮数"
						Classes="outline"/>
				</StackPanel>
				<StackPanel Grid.Row="4" Margin="0,0,0,20">
					<TextBlock Text="优化器" Margin="0,0,0,5" FontSize="12" FontWeight="SemiBold"/>
					<ComboBox
						ItemsSource="{Binding Optimizers}"
						SelectedItem="{Binding SelectedOptimizer}"
						Classes="outline" />
				</StackPanel>
				<StackPanel Grid.Row="5" Margin="0,0,0,20">
					<TextBlock Text="验证集比例" Margin="0,0,0,5" FontSize="12" FontWeight="SemiBold"/>
					<ComboBox
						ItemsSource="{Binding ValidationSetRates}"
						SelectedItem="{Binding SelectedValidationSetRate}"
						SelectedIndex="1"
						Classes="outline" />
				</StackPanel>
				<Grid
					Grid.Row="6"
					RowDefinitions="35,Auto">
					<TextBlock
						Width="65"
						FontWeight="Bold"
						TextAlignment="Center"
						VerticalAlignment="Center"
						HorizontalAlignment="Left"
						Text="数据增强"/>
					<Border
						Grid.Row="1"
						CornerRadius="5"
						BorderThickness="1"
						Padding="8"
						BorderBrush="LightGray">
						<StackPanel Orientation="Vertical">
							<CheckBox
								Margin="0,0,0,0"
								IsChecked="{Binding RandomHorizonFlipChecked}"
								Content="随机水平翻转"/>
							<CheckBox
								Margin="0,5,0,0"
								IsChecked="{Binding RandomVerticalFlipChecked}"
								Content="随机垂直翻转"/>
							<CheckBox
								Margin="0,5,0,0"
								IsChecked="{Binding RandomRotationChecked}"
								Content="随机旋转"/>
							<CheckBox
								Margin="0,5,0,0"
								IsChecked="{Binding RandomZoomChecked}"
								Content="随机缩放"/>
							<CheckBox
								Margin="0,5,0,0"
								IsChecked="{Binding RandomBrightnessChecked}"
								Content="随机亮度"/>
							<CheckBox
								Margin="0,5,0,0"
								IsChecked="{Binding RandomContrastChecked}"
								Content="随机对比度"/>
						</StackPanel>
					</Border>
				</Grid>
			</Grid>
			<Grid
				Grid.Column="2"
				RowDefinitions="20,*"
				Margin="0,20,0,0">
				<TextBlock
					Grid.Row="0"
					Margin="0,0,0,30"
					Width="65"
					TextAlignment="Center"
					HorizontalAlignment="Left"
					Foreground="White"
					Background="Black"
					Text="高级参数"
					FontWeight="Bold"/>
				<ScrollViewer Grid.Row="1" Padding="0,0,10,0" Margin="0,0,0,30">
					<Grid RowDefinitions="100,100,100,100,*">
						<!--学习率调度策略-->
						<StackPanel Grid.Row="0" Margin="0,0,0,20">
							<TextBlock Text="学习率调度策略" Margin="0,0,0,5" FontSize="12" FontWeight="SemiBold"/>
							<ComboBox
								ItemsSource="{Binding SchedulingStrategies}"
								SelectedItem="{Binding SelectedStrategy,StringFormat={}{0:P1}}"
								Classes="outline" />
						</StackPanel>
						<!--权重衰减-->
						<StackPanel
							Grid.Row="1"
							Margin="0,0,0,20"
							Orientation="Vertical">
							<TextBlock Text="权重衰减" Margin="0,0,0,5" FontSize="12" FontWeight="SemiBold"/>
							<NumericUpDown
								Increment="0.0001"
								Value="{Binding WeightDecay}"
								Classes="outline"
								Watermark="权重衰减" />
						</StackPanel>
						<!--早停轮数-->
						<StackPanel
							Grid.Row="2"
							Margin="0,0,0,20"
							Orientation="Vertical">
							<TextBlock Text="早停轮数" Margin="0,0,0,5" FontSize="12" FontWeight="SemiBold"/>
							<NumericUpDown
								Increment="1"
								Value="{Binding EarlyStopRound}"
								Classes="outline"
								Watermark="早停轮数" />
						</StackPanel>
						<!--早停阈值-->
						<StackPanel
							Grid.Row="3"
							Margin="0,0,0,20"
							Orientation="Vertical">
							<TextBlock Text="早停阈值" Margin="0,0,0,5" FontSize="12" FontWeight="SemiBold"/>
							<NumericUpDown
								Increment="0.0001"
								Value="{Binding EarlyStopDelta}"
								Classes="outline"
								Watermark="早停阈值" />
						</StackPanel>
						<!--损失函数配置-->
						<Grid Grid.Row="4" RowDefinitions="20,*">
							<TextBlock
								Grid.Row="0"
								Width="88"
								TextAlignment="Center"
								HorizontalAlignment="Left"
								VerticalAlignment="Top"
								Text="损失函数配置"
								FontWeight="Bold"/>
							<Border
								Grid.Row="1"
								Background="WhiteSmoke"
								BorderBrush="LightGray"
								BorderThickness="1"
								CornerRadius="5"
								Padding="10">
								<Grid RowDefinitions="100,20,Auto,Auto">
									<StackPanel Grid.Row="0">
										<TextBlock Text="选择损失函数" Margin="0,0,0,5" FontSize="12" FontWeight="SemiBold"/>
										<ComboBox
											Name="LossFunction"
											ItemsSource="{Binding LossFunctionTypes}"
											Classes="outline"
											SelectedItem="{Binding SelectedLossFunction}">
										</ComboBox>
									</StackPanel>
									<TextBlock
										Name="TipText"
										Text="{Binding LossFunctionDescribe}"
										Grid.Row="1">
										<TextBlock.Styles>
											<Style Selector="TextBlock">
												<Setter Property="FontSize" Value="12"/>
												<Setter Property="Foreground" Value="Gray"/>
											</Style>
										</TextBlock.Styles>
									</TextBlock>
									<Grid Grid.Row="2" Name="LossFunctionParamsGrid">
										<!-- CrossEntropyLoss 参数配置 -->
										<Grid IsVisible="{Binding ElementName=LossFunction, Path=SelectedItem, Converter={StaticResource StringEqualsConverter}, ConverterParameter=CrossEntropyLoss}"
											  RowDefinitions="100,100,100">
											<StackPanel Grid.Row="0" Margin="0,10,0,0" Orientation="Vertical">
												<StackPanel Orientation="Horizontal">
													<TextBlock Text="weight"/>
													<TextBlock Margin="10,0,0,0" FontSize="12" Foreground="Gray" Text="各类别的权重，用于处理类别不平衡，格式如: 1.0,2.0,1.0"/>
												</StackPanel>
												<TextBox
													Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
													Name="CrossEntropyWeights"
													Classes="outline"
													Text="{Binding Weight,Mode=OneWayToSource,UpdateSourceTrigger=PropertyChanged}"
													Watermark="留空表示所有类别权重相等">
												</TextBox>
											</StackPanel>
											<StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,15,0,0">
												<StackPanel Orientation="Horizontal">
													<TextBlock Text="label_smoothing"/>
													<TextBlock Margin="10,0,0,0" FontSize="12" Foreground="Gray" Text="标签平滑因子，用于提高模型泛化能力"/>
												</StackPanel>
												<NumericUpDown
													Margin="0,10,0,0"
													Height="50"
													Value="{Binding LabelSmoothing}"
													Increment="0.1"
													Maximum="1"
													Minimum="0"
													Classes="outline">
												</NumericUpDown>
											</StackPanel>
											<StackPanel Grid.Row="2" Margin="0,10,0,0">
												<TextBlock Text="reduction 损失计算方式" Margin="0,0,0,5" FontSize="12" FontWeight="SemiBold"/>
												<ComboBox
												  Name="CrossEntropyReduction"
												  ItemsSource="{Binding Reductions}"
												  SelectedItem="{Binding SelectedReduction}"
												  Classes="outline"
												  SelectedIndex="0">
											</ComboBox>
											</StackPanel>
										</Grid>

										<!-- BCELoss 参数配置 -->
										<Grid IsVisible="{Binding ElementName=LossFunction, Path=SelectedItem, Converter={StaticResource StringEqualsConverter}, ConverterParameter=BCELoss}"
											  RowDefinitions="Auto,Auto" Margin="0,10">
											<StackPanel Grid.Row="0" Orientation="Vertical">
												<StackPanel Orientation="Horizontal">
													<TextBlock Text="weight"/>
													<TextBlock Margin="10,0,0,0" FontSize="12" Foreground="Gray" Text="每个批次样本的权重，用逗号分隔"/>
												</StackPanel>
												<TextBox
													Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
													Name="BCELossWeights"
													Classes="outline"
													Text="{Binding Weight}"
													Watermark="留空表示所有类别权重相等">
												</TextBox>
											</StackPanel>
											<StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0">
												<TextBlock Text="reduction 损失计算方式" Margin="0,0,0,5" FontSize="12" FontWeight="SemiBold"/>
												<ComboBox
												  Name="BCEReduction"
												  ItemsSource="{Binding Reductions}"
												  SelectedItem="{Binding SelectedReduction}"
												  Classes="outline"
												  SelectedIndex="0">
											</ComboBox>
											</StackPanel>
										</Grid>

										<!-- BCEWithLogitsLoss 参数配置 -->
										<Grid IsVisible="{Binding ElementName=LossFunction, Path=SelectedItem, Converter={StaticResource StringEqualsConverter}, ConverterParameter=BCEWithLogitsLoss}"
											  RowDefinitions="Auto,Auto,Auto">
											<StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,10,0,0">
												<StackPanel Orientation="Horizontal">
													<TextBlock Text="weight"/>
													<TextBlock Margin="10,0,0,0" FontSize="12" Foreground="Gray" Text="每个批次样本的权重"/>
												</StackPanel>
												<TextBox
													Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
													Name="BCEWithLogitsLossWeights"
													Classes="outline"
													Text="{Binding Weight}"
													Watermark="留空表示所有类别权重相等">
												</TextBox>
											</StackPanel>

											<StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,10,0,0">
												<StackPanel Orientation="Horizontal">
													<TextBlock Text="pos_weight"/>
													<TextBlock Margin="10,0,0,0" FontSize="12" Foreground="Gray" Text="正样本的权重，用于处理类别不平衡"/>
												</StackPanel>
												<TextBox
													Grid.ColumnSpan="2"
													Name="BCEWithLogitsLossPosWeight"
													Classes="outline"
													Text="{Binding Pos_weight}"
													Watermark="留空表示所有类别权重为1"/>
											</StackPanel>
											<StackPanel Grid.Row="2" Grid.Column="0" Margin="0,10,0,0">
												<TextBlock Text="reduction 损失计算方式" Margin="0,0,0,5" FontSize="12" FontWeight="SemiBold"/>
												<ComboBox
												  Name="BCELogitsReduction"
												  Classes="outline"
												  ItemsSource="{Binding Reductions}"
												  SelectedItem="{Binding SelectedReduction}">
											</ComboBox>
											</StackPanel>
										</Grid>

										<!-- MSELoss 参数配置 -->
										<Grid IsVisible="{Binding ElementName=LossFunction, Path=SelectedItem, Converter={StaticResource StringEqualsConverter}, ConverterParameter=MSELoss}"
											  RowDefinitions="Auto" ColumnDefinitions="*,*" Margin="0,10">
											<StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,5">
												<TextBlock Text="损失计算方式" Margin="0,0,0,5" FontSize="12" FontWeight="SemiBold"/>
												<ComboBox
												  Name="MSEReduction"
												  ItemsSource="{Binding Reductions}"
												  Classes="outline"
												  SelectedItem="{Binding SelectedReduction}">
											</ComboBox>
											</StackPanel>
										</Grid>

										<!-- L1Loss 参数配置 -->
										<Grid IsVisible="{Binding ElementName=LossFunction, Path=SelectedItem, Converter={StaticResource StringEqualsConverter}, ConverterParameter=L1Loss}"
											  RowDefinitions="Auto" ColumnDefinitions="*,*" Margin="0,10">
											<StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,5">
												<TextBlock Text="损失计算方式" Margin="0,0,0,5" FontSize="12" FontWeight="SemiBold"/>
												<ComboBox
												  Name="L1Reduction"
												  Classes="outline"
												  ItemsSource="{Binding Reductions}"
												  SelectedItem="{Binding SelectedReduction}">
											</ComboBox>
											</StackPanel>
										</Grid>

										<!-- SmoothL1Loss 参数配置 -->
										<Grid IsVisible="{Binding ElementName=LossFunction, Path=SelectedItem, Converter={StaticResource StringEqualsConverter}, ConverterParameter=SmoothL1Loss}"
											  RowDefinitions="Auto,Auto" Margin="0,10">
											<StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,10,0,0">
												<StackPanel Orientation="Horizontal">
													<TextBlock Text="Beta"/>
													<TextBlock Margin="10,0,0,0" FontSize="12" Foreground="Gray" Text="平滑参数，决定MSE和L1的过渡点"/>
												</StackPanel>
												<NumericUpDown
													Margin="0,10,0,0"
													Height="50"
													Value="{Binding Beta}"
													Increment="0.1"
													Minimum="0"
													Classes="outline"/>
											</StackPanel>
											<StackPanel Grid.Row="1" Margin="0,15,0,0">
												<TextBlock Text="损失计算方式" Margin="0,0,0,5" FontSize="12" FontWeight="SemiBold"/>
												<ComboBox
												  Name="SmoothL1Reduction"
												  Classes="outline"
												  ItemsSource="{Binding Reductions}"
												  SelectedItem="{Binding SelectedReduction}">
											</ComboBox>
											</StackPanel>
										</Grid>

										<!-- KLDivLoss 参数配置 -->
										<Grid IsVisible="{Binding ElementName=LossFunction, Path=SelectedItem, Converter={StaticResource StringEqualsConverter}, ConverterParameter=KLDivLoss}"
											  RowDefinitions="Auto" ColumnDefinitions="*,*" Margin="0,10">
											<StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,5">
												<TextBlock Text="损失计算方式" Margin="0,0,0,5" FontSize="12" FontWeight="SemiBold"/>
												<ComboBox
												  Name="KLDivReduction"
												  Classes="outline"
												  ItemsSource="{Binding KLDivLoss_Reductions}"
												  SelectedItem="{Binding SelectedReduction}">
											</ComboBox>
											</StackPanel>
										</Grid>
									</Grid>

									<StackPanel Grid.Row="3" Orientation="Vertical" Margin="0,10,0,0">
										<TextBlock Text="参数预览" Margin="0,0,0,5" FontSize="12" FontWeight="SemiBold"/>
										<Border CornerRadius="5" Background="AliceBlue" Margin="0,10,0,0" Padding="10">
											<SelectableTextBlock
												MinHeight="180"
												SelectionForegroundBrush="White"
												Text="{Binding CodePreview}"/>
										</Border>
									</StackPanel>
								</Grid>
							</Border>
						</Grid>
					</Grid>
				</ScrollViewer>
			</Grid>
		</Grid>
	</Grid>
</UserControl>