<UserControl
    x:Class="AutoTrainer.DatasetAnnotationView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    	xmlns:notification="clr-namespace:Avalonia.Notification.Controls;assembly=Notification.Avalonia"
    xmlns:converter="using:AutoTrainer.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
    xmlns:ia="clr-namespace:Avalonia.Xaml.Interactions.Core;assembly=Avalonia.Xaml.Interactions"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:AutoTrainer.Models"
      xmlns:paz="using:Avalonia.Controls.PanAndZoom"
    xmlns:vm="using:AutoTrainer.ViewModels"
    x:Name="DataAnnotationView"
    Padding="10,0,10,0"
    d:DesignHeight="850"
    d:DesignWidth="1300"
    x:DataType="vm:DatasetAnnotationViewModel"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converter:BoolToBrushConverter x:Key="BoolToBrushConverter" />
    </UserControl.Resources>
	<Grid>
		<notification:NotificationMessageContainer Manager="{Binding NotifyManager}" ZIndex="999"/>
        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <!--  左侧工具栏  -->
            <ColumnDefinition Width="*" />
            <!--  主图像区域  -->
            <ColumnDefinition Width="300" />
            <!--  右侧属性面板  -->
        </Grid.ColumnDefinitions>

        <!--  左侧工具栏  -->
        <Border
            Grid.Column="0"
            Background="#F5F5F5"
            BorderBrush="LightGray"
            BorderThickness="0,0,1,0">
            <ScrollViewer>
                <StackPanel Margin="10" Spacing="15">

                    <!--  标注模式选择  -->
                    <Expander Header="标注模式" IsExpanded="True">
                        <StackPanel Margin="10" Spacing="8">
                            <RadioButton
                                Command="{Binding SelectManualModeCommand}"
                                Content="手动标注"
                                IsChecked="True"
                                ToolTip.Tip="逐张手动标注图片" />
                            <RadioButton
                                Command="{Binding SelectAIModeCommand}"
                                Content="智能辅助"
                                ToolTip.Tip="AI辅助预标注" />
                        </StackPanel>
                    </Expander>

                    <!--  标注工具  -->
                    <Expander Header="标注工具" IsExpanded="True">
                        <StackPanel Margin="10" Spacing="8">
                            <RadioButton
                                Command="{Binding SelectRectangleToolCommand}"
                                Content="矩形框"
                                GroupName="AnnotationTools"
                                IsChecked="True"
                                ToolTip.Tip="绘制矩形标注框" />
                            <RadioButton
                                Command="{Binding SelectPolygonToolCommand}"
                                Content="多边形"
                                GroupName="AnnotationTools"
                                ToolTip.Tip="绘制多边形标注区域" />
                            <RadioButton
                                Command="{Binding SelectPointToolCommand}"
                                Content="点标注"
                                GroupName="AnnotationTools"
                                ToolTip.Tip="关键点标注" />
                            <Separator />

                            <Button
                                Classes="light"
                                Command="{Binding ClearAllAnnotationsCommand}"
                                CommandParameter="{Binding ElementName=AnnotationCanvas}"
                                Content="清除该图全部标注"
                                ToolTip.Tip="清除当前图片所有标注" />
                            <!--  Command="{Binding ClearAnnotationsCommand}"  -->
                        </StackPanel>
                    </Expander>

                    <!--  类别管理  -->
                    <Expander Header="类别管理" IsExpanded="True">
                        <StackPanel Margin="10" Spacing="8">
                            <TextBox Text="{Binding NewClassName}" Watermark="输入新类别名称" />
                            <!--  Text="{Binding NewClassName}"  -->

                            <Button
                                Classes="accent"
                                Command="{Binding AddClassCommand}"
                                Content="添加类别" />
                            <!--  Command="{Binding AddClassCommand}"  -->

                            <ListBox
                                MaxHeight="150"
                                ItemsSource="{Binding ClassNames}"
                                SelectedItem="{Binding SelectedClassName}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                Text="{Binding .}" />
                                            <Button
                                                Grid.Column="1"
                                                Width="20"
                                                Height="20"
                                                Classes="light"
                                                Content="×"
                                                Command="{Binding $parent[ListBox].DataContext.RemoveClassCommand}"
                                                CommandParameter="{Binding .}"
                                                ToolTip.Tip="删除类别" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Expander>

                    <!--  数据管理  -->
                    <Expander Header="数据管理" IsExpanded="True">
                        <StackPanel Margin="10" Spacing="8">
                            <Button
                                Classes="light"
                                Command="{Binding ImportImageFolderCommand}"
                                CommandParameter="{Binding ElementName=DataAnnotationView}"
                                Content="导入目录" />
                            <Button
                                Classes="light"
                                Command="{Binding ImportAnnotationsCommand}"
                                CommandParameter="{Binding ElementName=DataAnnotationView}"
                                Content="导入标注" />
                            <Button
                                Classes="light"
                                Command="{Binding ExportAnnotationsCommand}"
                                Content="导出标注" />
                        </StackPanel>
                    </Expander>

                    <!--  统计信息  -->
                    <Expander Header="统计信息" IsExpanded="True">
                        <StackPanel Margin="10" Spacing="5">
                            <TextBlock Text="{Binding TotalImageCount, StringFormat='总图片数: {0}'}" />
                            <!--  Text="{Binding TotalImageCount, StringFormat='总图片数: {0}'}"  -->

                            <TextBlock Text="{Binding AnnotatedImageCount, StringFormat='已标注: {0}'}" />
                            <!--  Text="{Binding AnnotatedImageCount, StringFormat='已标注: {0}'}"  -->

                            <TextBlock Text="{Binding TotalAnnotationCount, StringFormat='标注框总数: {0}'}" />
                            <!--  Text="{Binding TotalAnnotationCount, StringFormat='标注框总数: {0}'}"  -->

                            <ProgressBar
                                Height="6"
                                Maximum="{Binding TotalImageCount}"
                                Value="{Binding AnnotatedImageCount}" />
                            <!--  Maximum="{Binding TotalImageCount}" Value="{Binding AnnotatedImageCount}"  -->
                        </StackPanel>
                    </Expander>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!--  主图像区域  -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <!--  顶部工具栏  -->
                <RowDefinition Height="*" />
                <!--  图像显示区  -->
                <RowDefinition Height="120" />
                <!--  底部缩略图  -->
            </Grid.RowDefinitions>

            <!--  顶部工具栏  -->
            <Border
                Grid.Row="0"
                Background="White"
                BorderBrush="LightGray"
                BorderThickness="0,0,0,1">
                <Grid Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  左侧按钮组  -->
                    <StackPanel
                        Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="10">
                        <Button
                            Width="60"
                            Height="30"
                            Classes="light"
                            Command="{Binding PreviousImageCommand}"
                            IsEnabled="{Binding CanGoPrevious}"
                            ToolTip.Tip="上一张图片">
                            <!--  Command="{Binding PreviousImageCommand}" IsEnabled="{Binding CanGoPrevious}"  -->
                            <Path Width="20" Height="20" Data="M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z" Fill="Black"/>
                        </Button>

                        <Button
                            Width="60"
                            Height="30"
                            Classes="light"
                            Command="{Binding NextImageCommand}"
                            IsEnabled="{Binding CanGoNext}"
                            ToolTip.Tip="下一张图片">
                            <!--  Command="{Binding NextImageCommand}" IsEnabled="{Binding CanGoNext}"  -->
                            <Path Width="20" Height="20" Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z" Fill="Black"/>
                        </Button>
                    </StackPanel>

                    <!--  中间图片信息  -->
                    <StackPanel
                        Grid.Column="1"
                        Margin="10,0,10,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="10">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Text="{Binding CurrentImageSize}" />
                        <!--  Text="{Binding CurrentImageInfo}"  -->

                        <TextBlock VerticalAlignment="Center" Text="{Binding ElementName=ImageZoomBorder, Path=ZoomX, StringFormat='缩放: {0:F0}%'}" />
                    </StackPanel>

                    <!--  右侧按钮组  -->
                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="10">
                        <Button
                            Width="60"
                            Height="30"
                            Classes="light"
                            Command="{Binding UndoCommand}"
                            IsEnabled="{Binding CanUndo}"
                            ToolTip.Tip="撤销">
                            <!--  Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}"  -->
                            <Path Width="20" Height="20" Data="M12.5,8C9.85,8 7.45,9 5.6,10.6L2,7V16H11L7.38,12.38C8.77,11.22 10.54,10.5 12.5,10.5C16.04,10.5 19.05,12.81 20.1,16L22.47,15.22C21.08,11.03 17.15,8 12.5,8Z" Fill="Black"/>
                        </Button>

                        <Button
                            Width="60"
                            Height="30"
                            Classes="light"
                            Command="{Binding RedoCommand}"
                            IsEnabled="{Binding CanRedo}"
                            ToolTip.Tip="重做">
                            <!--  Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}"  -->
                            <Path Width="20" Height="20" Data="M18.4,10.6C16.55,9 14.15,8 11.5,8C6.85,8 2.92,11.03 1.54,15.22L3.91,16C4.95,12.81 7.96,10.5 11.5,10.5C13.46,10.5 15.23,11.22 16.62,12.38L13,16H22V7L18.4,10.6Z" Fill="Black"/>
                        </Button>

                        <Button
                            Width="60"
                            Height="30"
                            Classes="light"
                            Command="{Binding SaveCurrentAnnotationCommand}"
                            ToolTip.Tip="保存当前标注或分类">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Path
                                    Width="18"
                                    Height="18"
                                    Data="M9,20.42L2.79,14.21L5.62,11.38L9,14.77L18.88,4.88L21.71,7.71L9,20.42Z"
                                    Fill="Green"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!--  图像显示区域  -->
            <Border
                x:Name="ImageBorder"
                Grid.Row="1"
                Background="Gray"
                BorderBrush="LightGray"
                BorderThickness="1">
                <paz:ZoomBorder
                    x:Name="ImageZoomBorder"
					ScrollViewer.HorizontalScrollBarVisibility="Auto"
					ScrollViewer.VerticalScrollBarVisibility="Auto"
                    ClipToBounds="True"
                    Focusable="True"
                    Stretch="None"
                    ZoomSpeed="1.2">
                    <Grid>
                        <!--  主图像  -->
                        <Image
                            x:Name="MainImage"
                            Width="{Binding CurrentImage.PixelSize.Width}"
                            Height="{Binding CurrentImage.PixelSize.Height}"
                            Source="{Binding CurrentImage}" />
                        <!--  标注层  -->
                        <Canvas
                            x:Name="AnnotationCanvas"
                            Width="{Binding CurrentImage.PixelSize.Width}"
                            Height="{Binding CurrentImage.PixelSize.Height}"
                            Background="Transparent"
                            ClipToBounds="True"
                            IsVisible="True" />
                    </Grid>
                </paz:ZoomBorder>
            </Border>

            <!--  底部缩略图导航  -->
            <Border
                Grid.Row="2"
                Background="White"
                BorderBrush="LightGray"
                BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

					<Grid Grid.Row="0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition/>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>
						<TextBlock
							Grid.Column="0"
	                        Margin="10,5"
	                        HorizontalAlignment="Left"
	                        FontWeight="Bold"
	                        Text="图片导航" />
						<ProgressBar
							Grid.Column="1"
							Value="{Binding ProgressValue}"
							Maximum="{Binding ProgressMax}"
							Margin="0,5,10,0"/>
						<TextBlock
							Grid.Column="2"
							Margin="10,5,10,0"
							Text="{Binding ProgressValue, StringFormat=已完成:{}{0}}"/>
						<TextBlock
							Grid.Column="3"
							Margin="5,0"
							Text="{Binding ImageList.Count,StringFormat=总计{}{0}张}"/>
					</Grid>
					<ScrollViewer 
						x:Name="ImageScrollViewer" 
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled">
                        <ListBox
                            Margin="10,0,10,10"
                            ItemsSource="{Binding ImageList}"
                            ScrollViewer.HorizontalScrollBarVisibility="Auto"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                            SelectedIndex="{Binding CurrentImageIndex}"
                            SelectionMode="Single">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Width="80"
                                            Height="60"
                                            BorderBrush="{Binding IsSelected, Converter={StaticResource BoolToBrushConverter}}"
                                            BorderThickness="2"
                                            CornerRadius="3"
                                            Cursor="Hand">
                                            <Grid Margin="3">
                                                <Image
                                                    Source="{Binding Thumbnail}"
                                                    Stretch="UniformToFill"
                                                    ZIndex="0" />
                                                <!--  标注状态指示  -->
                                                <Border
                                                    Width="16"
                                                    Height="16"
                                                    Margin="2"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Background="Green"
                                                    CornerRadius="8"
                                                    IsVisible="{Binding IsAnnotated}"
                                                    ZIndex="1">
                                                    <Path
                                                        Width="12"
                                                        Height="12"
                                                        Data="M9,20.42L2.79,14.21L5.62,11.38L9,14.77L18.88,4.88L21.71,7.71L9,20.42Z"
                                                        Fill="White"/>
                                                </Border>

                                                <!--  选中遮罩  -->
                                                <Border
                                                    Background="Blue"
                                                    IsVisible="{Binding IsSelected}"
                                                    Opacity="0.5"
                                                    ZIndex="2" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                        </ListBox>
					</ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!--  右侧属性面板  -->
        <Border
            Grid.Column="2"
            Background="#F5F5F5"
            BorderBrush="LightGray"
            BorderThickness="1,0,0,0">
            <ScrollViewer>
                <StackPanel Margin="10" Spacing="15">

                    <!--  图片信息  -->
                    <Expander Header="图片信息" IsExpanded="True">
                        <StackPanel Margin="10" Spacing="5">
                            <TextBlock Text="{Binding CurrentImageFileName, StringFormat='文件名: {0}'}" TextWrapping="Wrap" />
                            <!--  Text="{Binding CurrentImageFileName, StringFormat='文件名: {0}'}"  -->

                            <TextBlock Text="{Binding CurrentImageSize, StringFormat='尺寸: {0}'}" />
                            <!--  Text="{Binding CurrentImageSize, StringFormat='尺寸: {0}'}"  -->

                            <TextBlock Text="{Binding CurrentImageAnnotations.Count, StringFormat='标注数: {0}'}" />
                            <!--  Text="{Binding CurrentImageAnnotationCount, StringFormat='标注数: {0}'}"  -->

                            <TextBlock Text="{Binding CurrentImage.Dpi, StringFormat='状态: {0}'}" />
                            <!--  Text="{Binding CurrentImageStatus, StringFormat='状态: {0}'}"  -->
                        </StackPanel>
                    </Expander>

                    <!--  当前标注信息  -->
                    <Expander Header="当前标注" IsExpanded="True">
                        <StackPanel Margin="10" Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="5" Grid.Column="0">
                                    <TextBlock Text="选择类别" FontSize="12" Margin="0,0,0,2"/>
                                    <ComboBox
                                        ItemsSource="{Binding ClassNames}"
                                        SelectedItem="{Binding SelectedClassForAction, Mode=TwoWay}" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    Width="30"
                                    Height="30"
                                    Margin="5,0,0,0"
                                    VerticalAlignment="Center"
                                    Classes="accent"
                                    Command="{Binding AddImageClassCommand}"
                                    ToolTip.Tip="添加图像分类">
                                    <Path
                                        Width="16"
                                        Height="16"
                                        Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"
                                        Fill="White"/>
                                </Button>
                            </Grid>
                            <TextBlock Text="边界框" Margin="0,10,0,10" IsVisible="{Binding HasSelectedAnnotation}"/>
                            <!--  坐标信息  -->
                            <Grid IsEnabled="{Binding HasSelectedAnnotation}" IsVisible="{Binding HasSelectedAnnotation}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                            
                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Text="X:" />
                                <NumericUpDown
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Minimum="0"
                                    Value="{Binding SelectedAnnotation.BoundingBoxInfo.X, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Text="Y:" />
                                <NumericUpDown
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Minimum="0"
                                    Value="{Binding SelectedAnnotation.BoundingBoxInfo.Y}" />
                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Text="W:" />
                                <NumericUpDown
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Minimum="1"
                                    Value="{Binding SelectedAnnotation.BoundingBoxInfo.Width}" />
                                <TextBlock
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Text="H:" />
                                <NumericUpDown
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Minimum="1"
                                    Value="{Binding SelectedAnnotation.BoundingBoxInfo.Height}"/>
                            </Grid>
                            
                            <Button
                                Classes="light"
                                Command="{Binding DeleteSelectedAnnotationCommand}"
                                CommandParameter="{Binding ElementName=AnnotationCanvas}"
                                Content="删除标注"
                                IsEnabled="{Binding HasSelectedAnnotation}"
                                IsVisible="{Binding HasSelectedAnnotation}"/>
                        </StackPanel>
                    </Expander>
                            
                    <!--  图像分类列表  -->
                    <Expander Header="图像分类列表" IsExpanded="True" IsVisible="{Binding HasNoSelectedAnnotation}">
                        <ListBox
                            MaxHeight="200"
                            ItemsSource="{Binding CurrentImageClasses}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding .}" />
                                        <Button
                                            Grid.Column="1"
                                            Width="20"
                                            Height="20"
                                            Classes="light"
                                            Content="×"
                                            Command="{Binding $parent[ListBox].DataContext.RemoveImageClassCommand}"
                                            CommandParameter="{Binding .}"
                                            ToolTip.Tip="删除分类" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Expander>
                            
                    <!--  标注列表  -->
                    <Expander Header="标注列表" IsExpanded="True" IsVisible="{Binding HasSelectedAnnotation}">  
					<ListBox
                        MaxHeight="200"
                        ItemsSource="{Binding CurrentImageAnnotations}"
                        SelectedItem="{Binding SelectedAnnotation}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock FontWeight="Bold" Text="{Binding ClassName}" />
                                        <TextBlock
                                            FontSize="10"
                                            Foreground="Gray"
                                            Text="xxxx" />
                                    </StackPanel>

                                    <CheckBox
                                        Grid.Column="1"
                                        IsChecked="True"
                                        ToolTip.Tip="显示/隐藏标注" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Expander>

                    <!--  快捷操作  -->
                    <Expander Header="快捷操作" IsExpanded="True">
                        <StackPanel Margin="10" Spacing="8">
                            <CheckBox
                                x:Name="Chk_ApplyAsTemplate"
                                HorizontalAlignment="Center"
                                Content="作为模板应用至全体图片"
                                IsChecked="{Binding IsApplyAsTemplate}" />
                            <Button Classes="light" Content="在资源管理器显示" />
							<Button
	                            Classes="light"
	                            Command="{Binding SaveAllAnnotationsCommand}"
	                            Content="保存全部图片标注" />
                            <Button Classes="light" Command="{Binding BatchCreateDatasetCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Path
                                        Width="16"
                                        Height="16"
                                        Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M12,6A6,6 0 0,0 6,12A6,6 0 0,0 12,18A6,6 0 0,0 18,12A6,6 0 0,0 12,6M12,8A4,4 0 0,1 16,12A4,4 0 0,1 12,16A4,4 0 0,1 8,12A4,4 0 0,1 12,8Z">
                                        <Path.RenderTransform>
                                            <RotateTransform Angle="0"/>
                                        </Path.RenderTransform>
                                    </Path>
                                    <TextBlock IsVisible="{Binding IsNotBatchProcessing}" Text="批生成分类数据集"/>
                                </StackPanel>
                            </Button>
							<Button
                                Classes="light"
                                Command="{Binding CroppingImgAsDataSetCommand}">
								<StackPanel Orientation="Horizontal" Spacing="5">
								    <Path
                                        Width="16"
                                        Height="16"
                                        Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M12,6A6,6 0 0,0 6,12A6,6 0 0,0 12,18A6,6 0 0,0 18,12A6,6 0 0,0 12,6M12,8A4,4 0 0,1 16,12A4,4 0 0,1 12,16A4,4 0 0,1 8,12A4,4 0 0,1 12,8Z">
                                        <Path.RenderTransform>
                                            <RotateTransform Angle="0"/>
                                        </Path.RenderTransform>
                                    </Path>
								    <TextBlock IsVisible="{Binding IsShowCroppingText}" Text="裁剪并生成数据集"/>
								</StackPanel>
							</Button>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!--  加载遮罩  -->
        <Border
            Grid.ColumnSpan="3"
            Background="White"
            IsVisible="{Binding IsLoading}"
            Opacity="0.8">
            <!--  IsVisible="{Binding IsLoading}"  -->
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="10">
                <Path
                    Width="32"
                    Height="32"
