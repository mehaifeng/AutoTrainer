<UserControl
    x:Class="AutoTrainer.DatasetAnnotationView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:controls="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
	xmlns:notification="clr-namespace:Avalonia.Notification.Controls;assembly=Notification.Avalonia"
    xmlns:converter="using:AutoTrainer.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
    xmlns:ia="clr-namespace:Avalonia.Xaml.Interactions.Core;assembly=Avalonia.Xaml.Interactions"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:AutoTrainer.Models"
    xmlns:p1="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
    xmlns:paz="using:Avalonia.Controls.PanAndZoom"
    xmlns:vm="using:AutoTrainer.ViewModels"
    x:Name="DataAnnotationView"
    Padding="10,0,10,0"
    d:DesignHeight="850"
    d:DesignWidth="1300"
    x:DataType="vm:DatasetAnnotationViewModel"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converter:BoolToBrushConverter x:Key="BoolToBrushConverter" />
    </UserControl.Resources>
	<Grid>
		<notification:NotificationMessageContainer Manager="{Binding NotifyManager}" ZIndex="999"/>
        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <!--  左侧工具栏  -->
            <ColumnDefinition Width="*" />
            <!--  主图像区域  -->
            <ColumnDefinition Width="300" />
            <!--  右侧属性面板  -->
        </Grid.ColumnDefinitions>

        <!--  左侧工具栏  -->
        <Border
            Grid.Column="0"
            Background="#F5F5F5"
            BorderBrush="LightGray"
            BorderThickness="0,0,1,0">
            <ScrollViewer>
                <StackPanel Margin="10" Spacing="15">

                    <!--  标注模式选择  -->
                    <Expander Header="标注模式" IsExpanded="True">
                        <StackPanel Margin="10" Spacing="8">
                            <RadioButton
                                Command="{Binding SelectManualModeCommand}"
                                Content="手动标注"
                                IsChecked="True"
                                ToolTip.Tip="逐张手动标注图片" />
                            <RadioButton
                                Command="{Binding SelectAIModeCommand}"
                                Content="智能辅助"
                                ToolTip.Tip="AI辅助预标注" />
                        </StackPanel>
                    </Expander>

                    <!--  标注工具  -->
                    <Expander Header="标注工具" IsExpanded="True">
                        <StackPanel Margin="10" Spacing="8">
                            <RadioButton
                                Command="{Binding SelectRectangleToolCommand}"
                                Content="矩形框"
                                GroupName="AnnotationTools"
                                IsChecked="True"
                                ToolTip.Tip="绘制矩形标注框" />
                            <RadioButton
                                Command="{Binding SelectPolygonToolCommand}"
                                Content="多边形"
                                GroupName="AnnotationTools"
                                ToolTip.Tip="绘制多边形标注区域" />
                            <RadioButton
                                Command="{Binding SelectPointToolCommand}"
                                Content="点标注"
                                GroupName="AnnotationTools"
                                ToolTip.Tip="关键点标注" />
                            <Separator />

                            <Button
                                Classes="light"
                                Command="{Binding ClearAllAnnotationsCommand}"
                                CommandParameter="{Binding ElementName=AnnotationCanvas}"
                                Content="清除该图全部标注"
                                ToolTip.Tip="清除当前图片所有标注" />
                            <!--  Command="{Binding ClearAnnotationsCommand}"  -->
                        </StackPanel>
                    </Expander>

                    <!--  类别管理  -->
                    <Expander Header="类别管理" IsExpanded="True">
                        <StackPanel Margin="10" Spacing="8">
                            <TextBox Text="{Binding NewClassName}" Watermark="输入新类别名称" />
                            <!--  Text="{Binding NewClassName}"  -->

                            <Button
                                Classes="accent"
                                Command="{Binding AddClassCommand}"
                                Content="添加类别" />
                            <!--  Command="{Binding AddClassCommand}"  -->

                            <ListBox
                                MaxHeight="150"
                                ItemsSource="{Binding ClassNames}"
                                SelectedItem="{Binding SelectedClassName}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                Text="{Binding .}" />
                                            <Button
                                                Grid.Column="1"
                                                Width="20"
                                                Height="20"
                                                Classes="light"
                                                Content="×"
                                                ToolTip.Tip="删除类别" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Expander>

                    <!--  数据管理  -->
                    <Expander Header="数据管理" IsExpanded="True">
                        <StackPanel Margin="10" Spacing="8">
                            <Button
                                Classes="light"
                                Command="{Binding ImportImageFolderCommand}"
                                CommandParameter="{Binding ElementName=DataAnnotationView}"
                                Content="导入目录" />
                            <Button
                                Classes="light"
                                Command="{Binding ImportAnnotationsCommand}"
                                Content="导入标注" />
                            <Button
                                Classes="light"
                                Command="{Binding ExportAnnotationsCommand}"
                                Content="导出标注" />
                        </StackPanel>
                    </Expander>

                    <!--  统计信息  -->
                    <Expander Header="统计信息" IsExpanded="True">
                        <StackPanel Margin="10" Spacing="5">
                            <TextBlock Text="{Binding TotalImageCount, StringFormat='总图片数: {0}'}" />
                            <!--  Text="{Binding TotalImageCount, StringFormat='总图片数: {0}'}"  -->

                            <TextBlock Text="{Binding AnnotatedImageCount, StringFormat='已标注: {0}'}" />
                            <!--  Text="{Binding AnnotatedImageCount, StringFormat='已标注: {0}'}"  -->

                            <TextBlock Text="{Binding TotalAnnotationCount, StringFormat='标注框总数: {0}'}" />
                            <!--  Text="{Binding TotalAnnotationCount, StringFormat='标注框总数: {0}'}"  -->

                            <ProgressBar
                                Height="6"
                                Maximum="{Binding TotalImageCount}"
                                Value="{Binding AnnotatedImageCount}" />
                            <!--  Maximum="{Binding TotalImageCount}" Value="{Binding AnnotatedImageCount}"  -->
                        </StackPanel>
                    </Expander>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!--  主图像区域  -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <!--  顶部工具栏  -->
                <RowDefinition Height="*" />
                <!--  图像显示区  -->
                <RowDefinition Height="120" />
                <!--  底部缩略图  -->
            </Grid.RowDefinitions>

            <!--  顶部工具栏  -->
            <Border
                Grid.Row="0"
                Background="White"
                BorderBrush="LightGray"
                BorderThickness="0,0,0,1">
                <Grid Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  左侧按钮组  -->
                    <StackPanel
                        Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="10">
                        <Button
                            Width="60"
                            Height="30"
                            Classes="light"
                            Command="{Binding PreviousImageCommand}"
                            IsEnabled="{Binding CanGoPrevious}"
                            ToolTip.Tip="上一张图片">
                            <!--  Command="{Binding PreviousImageCommand}" IsEnabled="{Binding CanGoPrevious}"  -->
                            <avalonia:MaterialIcon
                                Width="20"
                                Height="20"
                                Kind="ChevronLeft" />
                        </Button>

                        <Button
                            Width="60"
                            Height="30"
                            Classes="light"
                            Command="{Binding NextImageCommand}"
                            IsEnabled="{Binding CanGoNext}"
                            ToolTip.Tip="下一张图片">
                            <!--  Command="{Binding NextImageCommand}" IsEnabled="{Binding CanGoNext}"  -->
                            <avalonia:MaterialIcon
                                Width="20"
                                Height="20"
                                Kind="ChevronRight" />
                        </Button>
                    </StackPanel>

                    <!--  中间图片信息  -->
                    <StackPanel
                        Grid.Column="1"
                        Margin="10,0,10,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="10">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Text="{Binding CurrentImageSize}" />
                        <!--  Text="{Binding CurrentImageInfo}"  -->

                        <TextBlock VerticalAlignment="Center" Text="{Binding ElementName=ImageZoomBorder, Path=ZoomX, StringFormat='缩放: {0:F0}%'}" />
                    </StackPanel>

                    <!--  右侧按钮组  -->
                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="10">
                        <Button
                            Width="60"
                            Height="30"
                            Classes="light"
                            Command="{Binding UndoCommand}"
                            IsEnabled="{Binding CanUndo}"
                            ToolTip.Tip="撤销">
                            <!--  Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}"  -->
                            <avalonia:MaterialIcon
                                Width="20"
                                Height="20"
                                Kind="Undo" />
                        </Button>

                        <Button
                            Width="60"
                            Height="30"
                            Classes="light"
                            Command="{Binding RedoCommand}"
                            IsEnabled="{Binding CanRedo}"
                            ToolTip.Tip="重做">
                            <!--  Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}"  -->
                            <avalonia:MaterialIcon
                                Width="20"
                                Height="20"
                                Kind="Redo" />
                        </Button>

                        <Button
                            Width="60"
                            Height="30"
                            Classes="light"
                            Command="{Binding SaveAnnotationCommand}"
                            ToolTip.Tip="保存标注">
                            <avalonia:MaterialIcon
                                Width="20"
                                Height="20"
                                Kind="ContentSave" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!--  图像显示区域  -->
            <Border
                x:Name="ImageBorder"
                Grid.Row="1"
                Background="Gray"
                BorderBrush="LightGray"
                BorderThickness="1">
                <paz:ZoomBorder
                    x:Name="ImageZoomBorder"
					ScrollViewer.HorizontalScrollBarVisibility="Auto"
					ScrollViewer.VerticalScrollBarVisibility="Auto"
                    ClipToBounds="True"
                    Focusable="True"
                    Stretch="None"
                    ZoomSpeed="1.2">
                    <Grid>
                        <!--  主图像  -->
                        <Image
                            x:Name="MainImage"
                            Width="{Binding CurrentImage.PixelSize.Width}"
                            Height="{Binding CurrentImage.PixelSize.Height}"
                            Source="{Binding CurrentImage}" />
                        <!--  标注层  -->
                        <Canvas
                            x:Name="AnnotationCanvas"
                            Width="{Binding CurrentImage.PixelSize.Width}"
                            Height="{Binding CurrentImage.PixelSize.Height}"
                            Background="Transparent"
                            ClipToBounds="True"
                            IsVisible="True" />
                    </Grid>
                </paz:ZoomBorder>
            </Border>

            <!--  底部缩略图导航  -->
            <Border
                Grid.Row="2"
                Background="White"
                BorderBrush="LightGray"
                BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

					<Grid Grid.Row="0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition/>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>
						<TextBlock
							Grid.Column="0"
	                        Margin="10,5"
	                        HorizontalAlignment="Left"
	                        FontWeight="Bold"
	                        Text="图片导航" />
						<ProgressBar
							Grid.Column="1"
							Value="{Binding FinishedCroppingCount}"
							Maximum="{Binding ImageList.Count}"
							Margin="0,5,10,0"/>
						<TextBlock
							Grid.Column="2"
							Margin="10,5,10,0"
							Text="{Binding FinishedCroppingCount, StringFormat=已完成:{}{0}}"/>
						<TextBlock
							Grid.Column="3"
							Margin="5,0"
							Text="{Binding ImageList.Count,StringFormat=总计{}{0}张}"/>
					</Grid>

					<ScrollViewer
						x:Name="ImageScrollViewer"
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled">
                        <ListBox
							Margin="10,0,10,10" 
							ItemsSource="{Binding ImageList}"
							SelectionMode="Single"
							SelectedIndex="{Binding CurrentImageIndex}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="5" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Width="80"
                                        Height="60"
                                        BorderBrush="{Binding IsSelected, Converter={StaticResource BoolToBrushConverter}}"
                                        BorderThickness="2"
                                        CornerRadius="3"
                                        Cursor="Hand">
                                        <Grid Margin="3">
                                            <Image
                                                Source="{Binding Thumbnail}"
                                                Stretch="UniformToFill"
                                                ZIndex="0" />
                                            <!--  标注状态指示  -->
                                            <Border
                                                Width="16"
                                                Height="16"
                                                Margin="2"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Background="Green"
                                                CornerRadius="8"
                                                IsVisible="{Binding IsAnnotated}"
                                                ZIndex="1">
                                                <avalonia:MaterialIcon
                                                    Width="12"
                                                    Height="12"
                                                    Foreground="White"
                                                    Kind="Check" />
                                            </Border>

                                            <!--  选中遮罩  -->
                                            <Border
                                                Background="Blue"
                                                IsVisible="{Binding IsSelected}"
                                                Opacity="0.5"
                                                ZIndex="2" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!--  右侧属性面板  -->
        <Border
            Grid.Column="2"
            Background="#F5F5F5"
            BorderBrush="LightGray"
            BorderThickness="1,0,0,0">
            <ScrollViewer>
                <StackPanel Margin="10" Spacing="15">

                    <!--  图片信息  -->
                    <Expander Header="图片信息" IsExpanded="True">
                        <StackPanel Margin="10" Spacing="5">
                            <TextBlock Text="{Binding CurrentImageFileName, StringFormat='文件名: {0}'}" TextWrapping="Wrap" />
                            <!--  Text="{Binding CurrentImageFileName, StringFormat='文件名: {0}'}"  -->

                            <TextBlock Text="{Binding CurrentImageSize, StringFormat='尺寸: {0}'}" />
                            <!--  Text="{Binding CurrentImageSize, StringFormat='尺寸: {0}'}"  -->

                            <TextBlock Text="{Binding CurrentImageAnnotations.Count, StringFormat='标注数: {0}'}" />
                            <!--  Text="{Binding CurrentImageAnnotationCount, StringFormat='标注数: {0}'}"  -->

                            <TextBlock Text="{Binding CurrentImage.Dpi, StringFormat='状态: {0}'}" />
                            <!--  Text="{Binding CurrentImageStatus, StringFormat='状态: {0}'}"  -->
                        </StackPanel>
                    </Expander>

                    <!--  当前标注信息  -->
                    <Expander Header="当前标注" IsExpanded="True">
                        <StackPanel Margin="10" Spacing="8">
                            <!--  类别选择  -->
							<ComboBox
								Theme="{StaticResource MaterialOutlineComboBox}"
								Classes="dense"
								p1:ComboBoxAssist.Label = "选择类别"
                                IsEnabled="{Binding HasSelectedAnnotation}"
                                ItemsSource="{Binding ClassNames}"
                                SelectedItem="{Binding SelectedAnnotation.ClassName,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" />
							<TextBlock Text="边界框" Margin="0,10,0,10"/>
                            <!--  坐标信息  -->
                            <Grid IsEnabled="{Binding HasSelectedAnnotation}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Text="X:" />
                                <NumericUpDown
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Minimum="0"
                                    Value="{Binding SelectedAnnotation.BoundingBoxInfo.X, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Text="Y:" />
                                <NumericUpDown
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Minimum="0"
                                    Value="{Binding SelectedAnnotation.BoundingBoxInfo.Y}" />
                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Text="W:" />
                                <NumericUpDown
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Minimum="1"
                                    Value="{Binding SelectedAnnotation.BoundingBoxInfo.Width}" />
                                <TextBlock
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Text="H:" />
                                <NumericUpDown
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Minimum="1"
                                    Value="{Binding SelectedAnnotation.BoundingBoxInfo.Height}"/>
                            </Grid>

                            <Button
                                Classes="light"
                                Command="{Binding DeleteSelectedAnnotationCommand}"
                                CommandParameter="{Binding ElementName=AnnotationCanvas}"
                                Content="删除标注"
                                IsEnabled="{Binding HasSelectedAnnotation}" />
                        </StackPanel>
                    </Expander>

                    <!--  标注列表  -->
                    <Expander Header="标注列表" IsExpanded="True">
                        <ListBox
                            MaxHeight="200"
                            ItemsSource="{Binding CurrentImageAnnotations}"
                            SelectedItem="{Binding SelectedAnnotation}">
                            <!--
                                ItemsSource="{Binding CurrentImageAnnotations}"
                                SelectedItem="{Binding SelectedAnnotation}"
                            -->
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock FontWeight="Bold" Text="{Binding ClassName}" />
                                            <TextBlock
                                                FontSize="10"
                                                Foreground="Gray"
                                                Text="xxxx" />
                                        </StackPanel>

                                        <CheckBox
                                            Grid.Column="1"
                                            IsChecked="True"
                                            ToolTip.Tip="显示/隐藏标注" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Expander>

                    <!--  快捷操作  -->
                    <Expander Header="快捷操作" IsExpanded="True">
                        <StackPanel Margin="10" Spacing="8">

                            <CheckBox
                                x:Name="Chk_ApplyAsTemplate"
                                HorizontalAlignment="Center"
                                Content="作为模板应用至全体图片"
                                IsChecked="{Binding IsApplyAsTemplate}" />

                            <Button Classes="light" Content="标记为完成" />

                            <Button Classes="light" Content="在文件管理器中显示" />

							<Button
                                Classes="light"
                                Command="{Binding CroppingImgAsDataSetCommand}">
								<Grid>
								    <avalonia:MaterialIcon Kind="Loading" IsVisible="{Binding IsCroppingInProgress}">
										<avalonia:MaterialIcon.Styles>
											<Style Selector="avalonia|MaterialIcon">
												<Style.Animations>
													<Animation Duration="0:0:1"
															 IterationCount="INFINITE">
														<KeyFrame Cue="0%">
															<Setter Property="RotateTransform.Angle" Value="0.0"/>
														</KeyFrame>
														<KeyFrame Cue="100%">
															<Setter Property="RotateTransform.Angle" Value="360.0"/>
														</KeyFrame>
													</Animation>
												</Style.Animations>
											</Style>
										</avalonia:MaterialIcon.Styles>
									</avalonia:MaterialIcon>
								    <TextBlock IsVisible="{Binding IsShowCroppingText}" Text="裁剪数据集"/>
								</Grid>
							</Button>
                                
                        </StackPanel>
                    </Expander>


                    <!--  Command="{Binding ApplyToSimilarCommand}"  -->


                </StackPanel>
            </ScrollViewer>
        </Border>

        <!--  加载遮罩  -->
        <Border
            Grid.ColumnSpan="3"
            Background="White"
            IsVisible="{Binding IsLoading}"
            Opacity="0.8">
            <!--  IsVisible="{Binding IsLoading}"  -->
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="10">
                <avalonia:MaterialIcon
                    Width="40"
                    Height="40"
                    Kind="Loading" />
                <TextBlock HorizontalAlignment="Center" Text="处理中..." />
            </StackPanel>
        </Border>

    </Grid>
	</Grid>
</UserControl>
